---
/**
 * Stylized mock of the app's side-by-side comparison view, shown in the
 * "See it in action" section (it was the hero art until the Twin Blobs
 * animation took over the hero).
 * Pure HTML/CSS (no screenshot, no JS) so it loads instantly and can't drift
 * from brand — colors, icon style (24px grid / 1.5px stroke feel) and baby
 * identity colors (Sky = first, Teal-green = second) come straight from the
 * style guide. It's a *sketch* of the UI, not a promise.
 *
 * When real screenshots exist, swap this component out in
 * src/sections/SeeItInAction.astro (see docs/LAUNCH-CHECKLIST.md).
 */

interface LogChip {
  icon: 'feed' | 'nap' | 'diaper';
  label: string;
  /** 'due' renders the coral "attention" treatment */
  tone?: 'default' | 'due';
}

const ICON_PATHS = {
  feed: 'M9 2h6M10 2v3h4V2M8 8a4 4 0 0 1 8 0v10a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2z', // bottle
  nap: 'M17 12a7 7 0 0 1-9.5 6.5A8 8 0 0 0 15 5.2 7 7 0 0 1 17 12z', // moon
  diaper: 'M4 8h16v4a8 8 0 0 1-6 7.7V16h-4v3.7A8 8 0 0 1 4 12z', // diaper
  clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2', // clock
} satisfies Record<LogChip['icon'] | 'clock', string>;

// `color` maps to a .peek__avatar--<color> class (not an inline style
// attribute — those are blocked by the site's hash-based CSP).
const babies: { name: string; color: 'sky' | 'teal'; chips: LogChip[] }[] = [
  {
    name: 'Baby A',
    color: 'sky',
    chips: [
      { icon: 'feed', label: 'Fed · 6:45am' },
      { icon: 'nap', label: 'Nap · 8:10am' },
      { icon: 'diaper', label: 'Change · 9:05am' },
    ],
  },
  {
    name: 'Baby B',
    color: 'teal',
    chips: [
      { icon: 'feed', label: 'Fed · 6:45am' },
      { icon: 'nap', label: 'Nap · 8:32am' },
      { icon: 'diaper', label: 'Due soon', tone: 'due' },
    ],
  },
];
---

<figure class="peek">
  <div
    class="peek__card"
    role="img"
    aria-label="Preview of Handsful: feeds, naps and diapers for two babies shown side by side, with one button that logs a feed for everyone at once"
  >
    <div class="peek__topbar">
      <span class="peek__title">Today</span>
      <span class="peek__badge">One tap · logged for both</span>
    </div>

    <div class="peek__columns">
      {
        babies.map((baby) => (
          <div class="peek__col">
            <div class="peek__baby">
              <span class={`peek__avatar peek__avatar--${baby.color}`} />
              <span class="peek__name">{baby.name}</span>
            </div>
            {baby.chips.map((chip) => (
              <span class={`peek__chip ${chip.tone === 'due' ? 'peek__chip--due' : ''}`}>
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={ICON_PATHS[chip.icon]} />
                </svg>
                {chip.label}
              </span>
            ))}
          </div>
        ))
      }
    </div>

    <div class="peek__next">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d={ICON_PATHS.clock} />
      </svg>
      Up next · 11:30am — bottles for both
    </div>

    <span class="peek__cta">Log a feed for everyone</span>
  </div>
  <figcaption class="peek__hint">today at a glance — both babies, side by side</figcaption>
</figure>

<style>
  .peek {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  /* Solid card; the gradient button INSIDE it sits on a solid background,
     which is allowed by the brand rules. Flex column + grow so the card
     matches its sibling mock's height, with the CTA pinned to the bottom. */
  .peek__card {
    width: min(360px, 100%);
    background: var(--warm-bg);
    border-radius: 28px;
    padding: var(--space-6);
    box-shadow: 0 16px 48px rgba(34, 32, 29, 0.16);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .peek__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .peek__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    color: var(--ink);
  }
  .peek__badge {
    background: var(--butter);
    color: var(--ink);
    font-size: 11px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.01em;
    padding: 6px 10px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .peek__columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  /* Shared schedule strip — fills the card and hints at the app thinking
     ahead for the whole crew */
  .peek__next {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: #fff;
    border-radius: var(--radius-md);
    padding: var(--space-3);
    font-size: 12px;
    line-height: 1;
    font-weight: 700;
    color: var(--taupe-dark);
    margin-bottom: var(--space-4);
  }
  .peek__next svg {
    flex-shrink: 0;
    color: var(--sky);
  }
  .peek__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background: #fff;
    border-radius: var(--radius-md);
    padding: var(--space-3);
  }
  .peek__baby {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }
  .peek__avatar {
    width: 18px;
    height: 18px;
    /* Organic blob, not a uniform circle — the brand motif carried down to
       the baby identities; each sibling gets their own shape */
    border-radius: 62% 38% 54% 46% / 48% 60% 40% 52%;
    flex-shrink: 0;
  }
  .peek__col:nth-child(2) .peek__avatar {
    border-radius: 42% 58% 46% 54% / 58% 42% 60% 40%;
  }
  .peek__avatar--sky {
    background: var(--sky);
  }
  .peek__avatar--teal {
    background: var(--teal);
  }
  .peek__name {
    font-weight: 700;
    font-size: 14px;
    color: var(--ink);
  }
  .peek__chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--warm-bg);
    color: var(--taupe-dark);
    font-size: 11.5px;
    line-height: 1;
    font-weight: 700;
    padding: 7px 8px;
    border-radius: var(--radius-pill);
    /* the longest label ("Change · 9:05am") must not wrap inside its chip */
    white-space: nowrap;
  }
  .peek__chip svg {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    color: var(--sky);
  }
  .peek__chip--due {
    background: rgba(255, 115, 87, 0.14);
    color: #8a4a3f; /* darkened coral from the brand ramp — readable at 12px */
  }
  .peek__chip--due svg {
    color: #b5514a;
  }

  .peek__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    /* auto margin pins the CTA to the card bottom when the card is
       stretched to match the sibling mock (columns carry the min gap) */
    margin-top: auto;
    min-height: 44px;
    border-radius: var(--radius-pill);
    background: var(--gradient-action);
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.01em;
  }

  .peek__hint {
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    font-style: italic;
    color: var(--taupe);
  }
</style>
