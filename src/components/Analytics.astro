---
/**
 * Google Analytics 4 via Google Consent Mode v2.
 *
 * gtag.js loads on every page, but the inline snippet defaults every consent
 * signal to "denied" BEFORE it loads — so GA sets no cookies and stores no
 * identifiers until the visitor consents. Consent comes from the site's own
 * banner (CookieConsentBanner.astro): BaseLayout's bootstrap snippet reads
 * the stored choice into window.__handsfulStoredConsent just before this
 * component's output, and a stored "granted" is re-applied below — after the
 * default, before gtag.js — so returning visitors' very first hit is decided
 * correctly. Live Accept/Decline clicks in the banner fire their own
 * gtag('consent', 'update', …) calls.
 *
 * Renders nothing until PUBLIC_GA_MEASUREMENT_ID is set, so GA stays
 * completely off in envs without the var (local dev, previews if unset).
 *
 * The snippet source lives in src/ga-snippet.ts because astro.config.mjs
 * hashes the identical string into the CSP script-src header — editing the
 * snippet there keeps script and hash in lockstep automatically.
 */
import { gaConsentSnippet } from '../ga-snippet';

const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '';
---

{
  gaId && (
    <>
      <script is:inline set:html={gaConsentSnippet(gaId)} />
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
    </>
  )
}
