---
/**
 * Google Analytics 4 via Google Consent Mode v2.
 *
 * gtag.js loads on every page, but the inline snippet defaults every consent
 * signal to "denied" BEFORE it loads — so GA sets no cookies and stores no
 * identifiers until a consent management platform grants them. Consent is
 * Termly's job: its embed (added separately in BaseLayout, above this
 * component's output) has Google Consent Mode support and calls
 * gtag('consent', 'update', …) when the visitor accepts. Nothing here needs
 * to know about Termly.
 *
 * Renders nothing until PUBLIC_GA_MEASUREMENT_ID is set, so GA stays
 * completely off in envs without the var (local dev, previews if unset).
 */
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '';
---

{
  gaId && (
    <>
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        window.gtag = gtag;
        /* Consent Mode v2 — must run before gtag.js. wait_for_update gives a
           CMP that loads early (Termly) a beat to apply stored choices before
           the first hit is decided. */
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          wait_for_update: 500,
        });
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
    </>
  )
}
