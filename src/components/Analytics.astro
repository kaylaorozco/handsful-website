---
/**
 * Google Analytics 4 via Google Consent Mode v2 — "basic" mode.
 *
 * gtag.js is NOT loaded (not even requested from the network) until analytics
 * consent is granted, so before consent — and forever after a Decline —
 * Google receives nothing at all: no cookies, no cookieless pings, no
 * IP/user-agent. The inline loader below injects the script when either:
 *   - BaseLayout's bootstrap found a stored, fresh "granted" choice
 *     (window.__handsfulStoredConsent), so returning visitors are tracked
 *     from their very first hit, or
 *   - the banner (CookieConsentBanner.astro) dispatches
 *     CONSENT_GRANTED_EVENT on a live Accept click.
 * The Consent Mode v2 signals are still set before gtag.js executes — ad
 * signals stay denied; only analytics_storage is ever granted.
 *
 * Renders nothing until PUBLIC_GA_MEASUREMENT_ID is set, so GA stays
 * completely off in envs without the var (local dev, previews if unset).
 *
 * The loader source lives in src/ga-snippet.ts because astro.config.mjs
 * hashes the identical string into the CSP script-src header — editing the
 * snippet there keeps script and hash in lockstep automatically.
 */
import { gaConsentSnippet } from '../ga-snippet';

const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '';
---

{gaId && <script is:inline set:html={gaConsentSnippet(gaId)} />}
