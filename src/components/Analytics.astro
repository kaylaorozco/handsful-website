---
/**
 * Consent-gated Google Analytics 4.
 *
 * GA is NOT loaded on page view. The inline script below only injects gtag.js
 * after the visitor has accepted cookies via the CookieConsent banner (choice
 * persisted in localStorage under "hf-cookie-consent"). Declining, or never
 * answering, means zero GA requests and zero cookies — GDPR/ePrivacy friendly.
 *
 * The banner dispatches a "hf-consent-granted" event on accept so GA starts
 * in the same visit without a reload.
 */
import { ANALYTICS } from '../config';

const gaId = ANALYTICS.gaMeasurementId;
---

{
  gaId && (
    <script is:inline define:vars={{ gaId }}>
      (function () {
        function loadGA() {
          if (window.__hfGaLoaded) return;
          window.__hfGaLoaded = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };
          window.gtag('js', new Date());
          window.gtag('config', gaId, { anonymize_ip: true });
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
        }
        try {
          if (localStorage.getItem('hf-cookie-consent') === 'granted') loadGA();
        } catch (e) {
          /* storage unavailable → treat as no consent */
        }
        window.addEventListener('hf-consent-granted', loadGA);
      })();
    </script>
  )
}
