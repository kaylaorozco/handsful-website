---
/**
 * Inline, recolorable Handsful wordmark. The source SVG is white letters plus
 * a coral dot and an ink dot; we swap the letter fills to currentColor so CSS
 * `color` controls them (Ink in the header, Warm bg in the footer).
 *
 * `onDark`: on dark backgrounds (Ink footer) the ink dot would vanish, so we
 * swap just that dot to Teal-green. The coral dot works on every approved
 * background and is left alone.
 */
import raw from '../assets/wordmark.svg?raw';

interface Props {
  class?: string;
  onDark?: boolean;
}
const { class: className = '', onDark = false } = Astro.props;

let svg = raw
  .replace(/fill="white"/g, 'fill="currentColor"')
  .replace(
    /<svg width="1024" height="406"/,
    `<svg class="wordmark ${className}" role="img" aria-label="Handsful"`,
  );

if (onDark) {
  svg = svg.replace(/fill="#22201D"/g, 'fill="#2F7D6B"');
}
---

<Fragment set:html={svg} />

<style is:global>
  .wordmark {
    display: block;
    height: 40px;
    width: auto;
  }
</style>
