---
/**
 * Cookie consent banner. Shows until the visitor makes a choice; the choice is
 * stored in localStorage ("hf-cookie-consent": "granted" | "denied").
 * Accepting dispatches "hf-consent-granted", which Analytics.astro listens for.
 * Analytics cookies stay blocked unless (and until) the visitor accepts.
 */
---

<div class="cookie-banner" id="cookie-banner" role="region" aria-label="Cookie consent" hidden>
  <p class="cookie-banner__text">
    We use a couple of cookies to understand how people find Handsful — nothing creepy.
    See our <a href="/cookie-policy">Cookie Policy</a>.
  </p>
  <div class="cookie-banner__actions">
    <button class="btn btn--primary" id="cookie-accept" type="button">Accept</button>
    <button class="btn btn--ghost" id="cookie-decline" type="button">Decline</button>
  </div>
</div>

<script>
  const KEY = 'hf-cookie-consent';
  const banner = document.getElementById('cookie-banner') as HTMLElement;
  const accept = document.getElementById('cookie-accept') as HTMLButtonElement;
  const decline = document.getElementById('cookie-decline') as HTMLButtonElement;

  let stored: string | null = null;
  try {
    stored = localStorage.getItem(KEY);
  } catch {
    /* storage unavailable — show banner but choices won't persist */
  }
  if (!stored) banner.hidden = false;

  function choose(value: 'granted' | 'denied') {
    try {
      localStorage.setItem(KEY, value);
    } catch {
      /* non-persistent, still honor for this page view */
    }
    banner.hidden = true;
    if (value === 'granted') window.dispatchEvent(new Event('hf-consent-granted'));
  }

  accept.addEventListener('click', () => choose('granted'));
  decline.addEventListener('click', () => choose('denied'));
</script>

<style>
  .cookie-banner {
    position: fixed;
    inset-inline: var(--space-4);
    bottom: var(--space-4);
    z-index: 50;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    max-width: 560px;
    margin-inline: auto;
    padding: var(--space-4) var(--space-6);
    background: #fff;
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 32px rgba(34, 32, 29, 0.18);
  }
  .cookie-banner__text {
    flex: 1 1 260px;
    font-size: 15px;
    line-height: 22px;
    color: var(--taupe-dark);
  }
  .cookie-banner__actions {
    display: flex;
    gap: var(--space-2);
  }
  .cookie-banner__actions .btn {
    min-height: 44px;
    padding-block: var(--space-2);
  }
</style>
