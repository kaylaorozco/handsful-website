---
/**
 * Email capture, posting to /api/subscribe (Kit, double opt-in).
 *
 * Now that the app is on the App Store, the store badge (StoreBadges.astro)
 * is the site's primary CTA and this form is the secondary one at the foot
 * of the page: it's how people hear about the Android release and what comes
 * after — so the copy talks about updates, not a queue.
 *
 * `variant` adapts styling to its background:
 *   'on-gradient' → gradient sections (solid Butter button per brand content-on-gradient rule)
 *   'on-solid'    → cream/white sections (action-gradient button)
 */
interface Props {
  variant?: 'on-gradient' | 'on-solid';
  /** Unique per instance — keeps input ids/labels valid with multiple forms per page. */
  formId: string;
  /** Passed through to the API for attribution (e.g. "hero", "footer-cta"). */
  source: string;
}

const { variant = 'on-solid', formId, source } = Astro.props;
---

<form
  class={`email-signup email-signup--${variant}`}
  method="POST"
  action="/api/subscribe"
  data-email-signup
  novalidate
>
  <div class="email-signup__row">
    <label class="visually-hidden" for={formId}>
      Email address
    </label>
    <input
      id={formId}
      class="email-signup__input"
      type="email"
      name="email"
      placeholder="you@example.com"
      autocomplete="email"
      required
    />
    {/* Honeypot — humans never see or fill this */}
    <input
      class="email-signup__hp"
      type="text"
      name="nickname"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />
    <input type="hidden" name="source" value={source} />
    <button
      class={`btn ${variant === 'on-gradient' ? 'btn--solid' : 'btn--primary'}`}
      type="submit"
    >
      Keep me posted
    </button>
  </div>
  {/* Deliberately broad — product news plus occasional updates — so the list
      isn't scoped to one announcement. Keep this in sync with the Privacy
      Policy's marketing section. */}
  <p class="email-signup__note" data-note>
    By subscribing, you agree to receive emails from Handsful about the app and occasional
    updates. Unsubscribe anytime. See our
    <a href="/privacy-policy">Privacy Policy</a>.
  </p>
  <p class="email-signup__status" data-status role="status" aria-live="polite"></p>
</form>

<script>
  // Progressive enhancement: without JS the form still POSTs to /api/subscribe,
  // which 303-redirects it to /waitlist-thanks or /waitlist-error; with JS we
  // submit JSON inline and show friendly states without leaving the page.
  // (Those page routes keep their /waitlist-* paths on purpose — Kit's
  // double opt-in redirect points at /waitlist-confirmed from the Kit
  // dashboard, so renaming them there and here has to happen together.)
  //
  // Success is deliberately "check your inbox", not "you're signed up" —
  // Kit's double opt-in means the signup only counts once they click the
  // confirmation link.
  const DONE_MESSAGES: Record<string, string> = {
    confirmation_sent:
      'Almost there — check your inbox and click the confirmation link to finish signing up. 📬',
    already_subscribed: "Good news: you're already signed up! We'll be in touch. 🎉",
    already_pending:
      "You've signed up before but haven't confirmed yet — look for our earlier email (spam folder too) and click the link inside.",
  };

  document.querySelectorAll<HTMLFormElement>('[data-email-signup]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const note = form.querySelector<HTMLElement>('[data-note]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const email = form.querySelector<HTMLInputElement>('input[type="email"]')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = '';
      if (!email.value || !email.checkValidity()) {
        status.textContent = 'That email looks a little off — mind checking it?';
        email.focus();
        return;
      }

      button.disabled = true;
      const originalLabel = button.textContent;
      button.textContent = 'Signing up…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok || !body.ok) {
          status.textContent =
            body.error ?? "That didn't go through — your typing's fine, just try again.";
          button.disabled = false;
          button.textContent = originalLabel;
          return;
        }
        form.querySelector('.email-signup__row')!.setAttribute('hidden', '');
        note.hidden = true;
        status.textContent = DONE_MESSAGES[body.status] ?? DONE_MESSAGES.confirmation_sent;
      } catch {
        status.textContent = "That didn't go through — your typing's fine, just try again.";
        button.disabled = false;
        button.textContent = originalLabel;
      }
    });
  });
</script>

<style>
  .email-signup {
    max-width: 480px;
  }
  .email-signup__row {
    display: flex;
    flex-wrap: wrap;
    /* When the button wraps under the input (narrow screens) it should
       center — both hosts (hero, final CTA) are centered layouts. */
    justify-content: center;
    gap: var(--space-2);
  }
  /* display:flex above beats the hidden attribute's UA default; on success
     the script hides the row via [hidden], so restore that behavior. */
  .email-signup__row[hidden] {
    display: none;
  }
  .email-signup__input {
    flex: 1 1 220px;
    min-height: 48px;
    padding: var(--space-3) var(--space-4);
    border: 2px solid transparent;
    border-radius: var(--radius-pill);
    background: #fff;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 15px;
  }
  .email-signup--on-solid .email-signup__input {
    border-color: rgba(34, 32, 29, 0.15);
  }
  .email-signup__input:focus-visible {
    /* Ink ring: 16.3:1 against the white input, 3.3:1 against the darkest
       hosting gradient region — always ≥3:1 (SC 2.4.7 / 1.4.11). The old
       butter border alone measured ~1.5:1: invisible to keyboard users. */
    outline: 3px solid var(--ink);
    outline-offset: 2px;
    border-color: var(--butter);
  }
  .email-signup__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .email-signup__note {
    margin-top: var(--space-3);
    font-size: 13px;
    line-height: 18px;
  }
  .email-signup--on-gradient .email-signup__note {
    /* Full-opacity white: the 0.85 alpha dropped this 13px text under AA
       on its gradient hosts; solid white measures ≥4.5:1 at the note's
       actual positions in the hero and final CTA (pixel-verified). */
    color: #fff;
  }
  .email-signup--on-solid .email-signup__note {
    color: var(--taupe);
  }
  /* The Privacy Policy link inherits the note's muted color per variant —
     the underline alone marks it as a link on both backgrounds. */
  .email-signup__note a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .email-signup--on-solid .email-signup__note a:hover {
    color: var(--ink);
  }
  .email-signup__status {
    margin-top: var(--space-3);
    font-weight: 700;
    font-size: 15px;
    line-height: 22px;
  }
  .email-signup--on-gradient .email-signup__status {
    color: #fff;
  }
  .email-signup--on-solid .email-signup__status {
    color: var(--teal);
  }
</style>
