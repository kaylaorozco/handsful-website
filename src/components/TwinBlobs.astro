---
/**
 * "Twin Blobs" — the hero's primary visual. Two organically-morphing blobs,
 * a wordless metaphor for simultaneous multi-baby tracking: each moves
 * independently (own morph cycle, duration and delay, so they never lock
 * step) but both ride one shared breathing pulse on the parent wrapper.
 *
 * Blob A wears the approved signature gradient (Sky → Teal-green → Butter);
 * Blob B wears a sibling palette (Coral → Teal-green) — related, not
 * identical. Colors come straight from the style guide; do not invent stops.
 *
 * Zero JS. The morph is CSS `d: path()` keyframes over five path variants
 * per blob — the same matched-point-count technique a Framer Motion path
 * tween uses, minus the React runtime this Astro site doesn't ship. All
 * variants share one command structure (M + 8 C + Z) or the tween couldn't
 * interpolate; they're generated by scripts/generate-blobs.mjs (seeded, so
 * re-runs reproduce these exact paths — tweak seeds there to reshape).
 *
 * Performance: `d` morphs + transform-only breathing scale; nothing here
 * touches layout. Browsers without CSS `d` support (Safari < 17.4) get the
 * static first variant from the SVG attribute — a graceful still blob.
 * Reduced motion: global.css zeroes all animation durations, which freezes
 * both the morph and the breath.
 */
---

<div class="blobs" aria-hidden="true">
  <svg class="blobs__svg" viewBox="0 0 640 520" fill="none" role="presentation">
    <defs>
      <!-- Signature gradient, transcribed from --gradient-signature (160deg) -->
      <linearGradient id="twin-blob-grad-a" x1="0.15" y1="0" x2="0.75" y2="1">
        <stop offset="0" stop-color="#3ea6c2"></stop>
        <stop offset="0.55" stop-color="#2f7d6b"></stop>
        <stop offset="1" stop-color="#ffcb57"></stop>
      </linearGradient>
      <!-- Sibling palette: Coral → Teal-green -->
      <linearGradient id="twin-blob-grad-b" x1="0.2" y1="0.05" x2="0.7" y2="1">
        <stop offset="0" stop-color="#ff7357"></stop>
        <stop offset="1" stop-color="#2f7d6b"></stop>
      </linearGradient>
    </defs>
    <path
      class="blobs__blob blobs__blob--a"
      fill="url(#twin-blob-grad-a)"
      d="M394.9 250.8 C395.6 286.0 375.6 344.2 345.0 370.5 C314.5 396.8 245.1 406.8 211.5 408.6 C177.9 410.4 165.5 408.8 143.5 381.2 C121.5 353.6 85.5 285.5 79.7 243.0 C73.8 200.4 83.7 152.5 108.7 125.8 C133.6 99.0 190.7 76.9 229.4 82.5 C268.1 88.0 313.3 131.1 340.9 159.1 C368.5 187.2 394.2 215.5 394.9 250.8 Z"
    ></path>
    <path
      class="blobs__blob blobs__blob--b"
      fill="url(#twin-blob-grad-b)"
      d="M555.4 293.8 C555.6 323.0 556.8 355.8 538.9 376.8 C521.0 397.8 479.4 420.6 448.0 419.9 C416.5 419.2 371.0 390.3 350.1 372.6 C329.2 354.8 320.7 337.8 322.6 313.2 C324.5 288.7 341.8 248.4 361.6 225.4 C381.3 202.4 411.8 179.2 441.1 175.3 C470.4 171.3 518.3 182.0 537.4 201.8 C556.4 221.5 555.1 264.7 555.4 293.8 Z"
    ></path>
  </svg>
</div>

<style>
  /* Morph targets from scripts/generate-blobs.mjs — regenerate there, don't
     hand-edit (every variant must keep the same command structure). */
  .blobs {
    --blob-a-0: path('M394.9 250.8 C395.6 286.0 375.6 344.2 345.0 370.5 C314.5 396.8 245.1 406.8 211.5 408.6 C177.9 410.4 165.5 408.8 143.5 381.2 C121.5 353.6 85.5 285.5 79.7 243.0 C73.8 200.4 83.7 152.5 108.7 125.8 C133.6 99.0 190.7 76.9 229.4 82.5 C268.1 88.0 313.3 131.1 340.9 159.1 C368.5 187.2 394.2 215.5 394.9 250.8 Z');
    --blob-a-1: path('M379.6 230.4 C384.2 264.7 371.6 326.1 346.7 352.3 C321.8 378.5 268.8 386.4 230.2 387.7 C191.7 388.9 144.3 382.0 115.5 360.1 C86.8 338.2 55.6 297.3 57.9 256.1 C60.2 214.9 101.9 141.4 129.3 113.0 C156.7 84.6 190.7 80.0 222.4 85.5 C254.0 91.0 293.1 121.9 319.3 146.0 C345.5 170.2 375.0 196.0 379.6 230.4 Z');
    --blob-a-2: path('M418.6 268.6 C419.4 307.8 374.3 317.7 341.1 339.4 C308.0 361.1 257.0 395.2 219.7 399.0 C182.4 402.9 137.9 390.5 117.6 362.3 C97.3 334.1 95.8 272.2 97.9 230.0 C100.0 187.7 108.4 127.4 130.2 108.8 C152.0 90.1 194.3 118.7 228.6 118.0 C262.9 117.3 304.4 79.6 336.1 104.7 C367.7 129.8 417.7 229.5 418.6 268.6 Z');
    --blob-a-3: path('M394.7 249.8 C399.1 290.2 386.1 328.1 357.2 350.7 C328.4 373.2 258.7 387.0 221.7 385.0 C184.7 382.9 160.7 360.2 135.3 338.3 C109.9 316.5 66.9 290.1 69.4 253.9 C71.9 217.7 122.9 146.8 150.2 121.1 C177.4 95.4 202.7 102.0 232.9 99.9 C263.0 97.7 304.0 83.4 331.0 108.4 C358.0 133.4 390.3 209.4 394.7 249.8 Z');
    --blob-a-4: path('M407.4 244.2 C405.8 277.9 385.0 323.6 358.2 354.1 C331.3 384.5 280.5 425.8 246.3 426.7 C212.1 427.7 182.1 390.8 152.7 359.9 C123.4 328.9 76.9 274.1 70.2 241.0 C63.5 207.9 86.9 190.1 112.8 161.2 C138.7 132.4 183.1 69.5 225.6 67.9 C268.2 66.3 337.6 122.2 367.9 151.6 C398.2 181.0 409.0 210.4 407.4 244.2 Z');
    --blob-b-0: path('M555.4 293.8 C555.6 323.0 556.8 355.8 538.9 376.8 C521.0 397.8 479.4 420.6 448.0 419.9 C416.5 419.2 371.0 390.3 350.1 372.6 C329.2 354.8 320.7 337.8 322.6 313.2 C324.5 288.7 341.8 248.4 361.6 225.4 C381.3 202.4 411.8 179.2 441.1 175.3 C470.4 171.3 518.3 182.0 537.4 201.8 C556.4 221.5 555.1 264.7 555.4 293.8 Z');
    --blob-b-1: path('M562.3 302.3 C565.6 332.8 553.8 373.2 532.5 388.6 C511.3 404.1 465.8 395.5 434.6 395.1 C403.5 394.6 365.2 406.2 345.8 385.8 C326.3 365.4 312.1 302.1 317.9 272.6 C323.6 243.1 355.4 230.5 380.2 208.8 C405.0 187.1 444.5 142.9 466.6 142.4 C488.8 141.9 497.1 179.2 513.0 205.9 C529.0 232.5 559.1 271.9 562.3 302.3 Z');
    --blob-b-2: path('M557.3 281.5 C558.8 309.3 565.2 332.6 546.3 352.4 C527.3 372.2 473.8 394.8 443.5 400.2 C413.2 405.7 384.6 405.3 364.4 385.1 C344.2 365.0 324.0 306.5 322.3 279.2 C320.7 251.9 336.5 243.4 354.4 221.3 C372.4 199.2 399.6 152.7 430.1 146.8 C460.6 140.8 516.3 163.1 537.5 185.6 C558.7 208.0 555.9 253.7 557.3 281.5 Z');
    --blob-b-3: path('M565.0 277.4 C564.7 305.4 530.6 350.2 509.8 372.5 C489.1 394.8 464.2 409.1 440.5 411.1 C416.8 413.1 390.0 408.8 367.6 384.4 C345.1 360.0 309.3 296.6 306.0 264.6 C302.6 232.7 325.8 206.1 347.4 192.6 C368.9 179.2 408.0 181.7 435.4 183.7 C462.7 185.7 489.8 188.9 511.4 204.5 C533.0 220.1 565.3 249.4 565.0 277.4 Z');
    --blob-b-4: path('M575.7 297.6 C582.4 326.8 583.8 357.3 564.3 374.6 C544.7 391.8 494.1 404.6 458.3 401.1 C422.6 397.6 372.8 374.2 349.9 353.5 C326.9 332.8 320.0 302.5 320.5 276.9 C321.0 251.3 335.9 218.9 352.8 199.8 C369.6 180.7 392.8 162.2 421.4 162.2 C449.9 162.2 498.4 177.2 524.1 199.8 C549.9 222.3 569.1 268.5 575.7 297.6 Z');

    /* The shared rhythm: one breath for both siblings. Transform-only. */
    animation: blobs-breathe 4s ease-in-out infinite;
    transform-origin: center;
    width: min(560px, 100%);
  }

  .blobs__svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Independent morphs: different durations, B starts mid-cycle, so the two
     never move in lockstep even though they share the breath above. */
  .blobs__blob--a {
    animation: blob-a-morph 22s ease-in-out infinite;
  }
  .blobs__blob--b {
    animation: blob-b-morph 17s ease-in-out infinite;
    animation-delay: -6s;
  }

  @keyframes blobs-breathe {
    0%,
    100% {
      transform: scale(0.97);
    }
    50% {
      transform: scale(1.03);
    }
  }

  @keyframes blob-a-morph {
    0%,
    100% {
      d: var(--blob-a-0);
    }
    20% {
      d: var(--blob-a-1);
    }
    40% {
      d: var(--blob-a-2);
    }
    60% {
      d: var(--blob-a-3);
    }
    80% {
      d: var(--blob-a-4);
    }
  }

  @keyframes blob-b-morph {
    0%,
    100% {
      d: var(--blob-b-0);
    }
    20% {
      d: var(--blob-b-1);
    }
    40% {
      d: var(--blob-b-2);
    }
    60% {
      d: var(--blob-b-3);
    }
    80% {
      d: var(--blob-b-4);
    }
  }
</style>
