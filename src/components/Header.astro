---
import Wordmark from './Wordmark.astro';
import { CTA, CTA_LABEL } from '../config';

// On the homepage the logo smooth-scrolls to the top (data-scroll-top handler
// in BaseLayout.astro); everywhere else it navigates home. The footer wordmark
// deliberately keeps always-scroll — the footer's own links cover navigation.
const isHome = Astro.url.pathname === '/';
---

<header class="header">
  <div class="container header__inner">
    <a
      href="/"
      class="header__logo"
      aria-label={isHome ? 'Handsful — back to top' : 'Handsful home'}
      data-scroll-top={isHome ? '' : undefined}
    >
      <Wordmark />
    </a>
    <nav class="header__nav" aria-label="Primary">
      <a href="/#features">Features</a>
      <a href="/#story">Our story</a>
      <a href="/#faq">FAQ</a>
      {/* Verb-only in the nav for space; the accessible name carries the full
          phrase so the link still says where it goes out of context. Both
          follow CTA.appleBadge — see CTA_LABEL in src/config.ts. */}
      <a
        href={CTA.appStoreUrl}
        class="btn btn--primary header__cta"
        aria-label={CTA_LABEL.long}
      >
        {CTA_LABEL.short}
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header); /* above page content, below the cookie banner */
    background: var(--warm-bg);
    border-bottom: 1px solid rgba(34, 32, 29, 0.08);
    box-shadow: 0 1px 8px rgba(34, 32, 29, 0.06);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
  .header__logo {
    color: var(--ink);
  }
  .header__logo :global(.wordmark) {
    height: 48px; /* wordmark min-width rule is 96px; at 48px tall it's ~121px wide */
  }
  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  .header__nav a:not(.btn) {
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.01em;
    color: var(--ink);
    text-decoration: none;
    padding: var(--space-2) 0; /* keep ≥44px effective tap area with line-height */
  }
  .header__nav a:not(.btn):hover {
    /* Teal, not sky — sky is 2.64:1 on the warm header background; hovered
       text still needs AA contrast (same fix as the global link color). */
    color: var(--teal);
  }
  .header__cta {
    min-height: 44px;
    padding-block: var(--space-2);
  }
  @media (max-width: 560px) {
    .header__nav a:not(.btn) {
      display: none; /* on small screens: logo + CTA only */
    }
  }
</style>
