---
import Wordmark from './Wordmark.astro';
import { SITE, SOCIAL } from '../config';

const year = new Date().getFullYear();

// Brand marks are solid glyphs (Simple Icons), unlike the stroked 24px UI icons
// used elsewhere — a logo has to match its trademark to stay recognisable.
const socials = [
  {
    label: 'Instagram',
    url: SOCIAL.instagram,
    path: 'M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07zM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.13 1.38C1.35 2.68.93 3.35.63 4.14.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.13.67.66 1.34 1.08 2.13 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.3 1.46-.72 2.13-1.38.66-.67 1.08-1.34 1.38-2.13.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91-.3-.79-.72-1.46-1.38-2.13C21.32 1.35 20.65.93 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.41-10.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z',
  },
  {
    label: 'Facebook',
    url: SOCIAL.facebook,
    path: 'M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 6.02 4.39 11.02 10.13 11.93v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8v8.44C19.61 23.09 24 18.09 24 12.07z',
  },
  {
    label: 'TikTok',
    url: SOCIAL.tiktok,
    path: 'M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z',
  },
].filter(({ url }) => url);
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      {/* href="/" is the no-JS fallback; with JS the wordmark smooth-scrolls
          the current page to the top instead of reloading (see the
          data-scroll-top handler in BaseLayout.astro). */}
      <a href="/" aria-label="Handsful — back to top" class="footer__logo" data-scroll-top>
        <Wordmark onDark />
      </a>
      <p class="footer__tagline">{SITE.tagline}</p>
    </div>

    <nav class="footer__col" aria-label="Product">
      <h4 class="footer__heading">Product</h4>
      <a href="/#features">Features</a>
      <a href="/#story">Our story</a>
      <a href="/#faq">FAQ</a>
      <a href="/#waitlist">Join the waitlist</a>
    </nav>

    <nav class="footer__col" aria-label="Legal">
      <h4 class="footer__heading">Legal</h4>
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/cookie-policy">Cookie Policy</a>
      <a href="/terms-of-service">Terms of Service</a>
      {/* Reopens the consent banner (CookieConsentBanner.astro listens on the
          data attribute). Both legal policies promise this link by name. */}
      <button type="button" class="footer__prefs" data-cookie-preferences>
        Cookie preferences
      </button>
    </nav>

    <div class="footer__col">
      <h4 class="footer__heading">Say hi</h4>
      <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
      <ul class="footer__social" aria-label="Social media">
        {
          socials.map(({ label, url, path }) => (
            <li>
              <a
                href={url}
                target="_blank"
                rel="me noopener noreferrer"
                aria-label={`Handsful on ${label}`}
                class="footer__social-link"
              >
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={path} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container footer__legalline">
    <p>© {year} Handsful. Made with love (and very little sleep).</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--warm-bg);
    padding-block: var(--space-16) var(--space-8);
  }
  .footer__inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-8);
  }
  .footer__logo {
    display: inline-block;
    color: var(--warm-bg);
    /* The wordmark SVG's glyphs start at x=125 of its 1024-wide viewBox, so
       the rendered mark carries invisible left padding (125/406 × the 40px
       height ≈ 12px). Pull it back so the "H" sits on the same vertical
       line as the tagline below. */
    margin-left: -12px;
  }
  .footer__tagline {
    margin-top: var(--space-4);
    color: rgba(250, 247, 242, 0.75);
    font-size: 15px;
    line-height: 22px;
    max-width: 32ch;
  }
  .footer__heading {
    /* Coral's recurring role site-wide: accent headings (hero glows, the
       flip-card pain labels, here) — ~6:1 on Ink, AA-safe at this size */
    color: var(--coral);
    margin-bottom: var(--space-3);
  }
  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .footer__col a {
    color: var(--warm-bg);
    text-decoration: none;
    font-size: 15px;
    line-height: 22px;
    padding-block: var(--space-1);
  }
  .footer__col a:hover {
    color: var(--butter);
  }
  /* A button dressed as a footer link — it triggers the consent banner
     rather than navigating, but must read identically to its neighbors. */
  .footer__prefs {
    background: none;
    border: 0;
    padding: var(--space-1) 0;
    color: var(--warm-bg);
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 22px;
    text-align: left;
    cursor: pointer;
  }
  .footer__prefs:hover {
    color: var(--butter);
  }
  .footer__social {
    list-style: none;
    /* -11px pulls the first 44px hit area back so its 22px glyph optically
       lines up with the email link above, rather than the padding doing it. */
    margin: var(--space-2) 0 0 -11px;
    padding: 0;
    display: flex;
    flex-direction: row;
    gap: var(--space-1);
  }
  .footer__social-link {
    /* 44px touch target around a 22px glyph — the text label that used to carry
       the tap area is gone now that these are icon-only. */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .footer__social-link:hover {
    background: rgba(250, 247, 242, 0.08);
  }
  .footer__legalline {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(250, 247, 242, 0.15);
    color: rgba(250, 247, 242, 0.6);
    font-size: 13px;
    line-height: 18px;
  }
  @media (max-width: 800px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
