---
/**
 * Cookie consent banner (issue #7) — the site's own consent UI, replacing the
 * original Termly plan.
 *
 * Contract with the GA setup:
 *   - The visitor's choice lives in localStorage as `handsful_cookie_consent`,
 *     a JSON object { value: 'granted' | 'denied', timestamp: <ISO date> }.
 *     A choice older than 12 months is expired: same as no choice (banner
 *     reshows, GA stays denied until re-accepted). Keep the key, shape, and
 *     TTL in sync with the consent bootstrap snippet in BaseLayout.astro,
 *     which reads a stored fresh 'granted' so Analytics.astro can apply it
 *     before gtag.js loads.
 *   - This component fires gtag('consent', 'update', …) only on user action
 *     (Accept / Decline), including choice changes made after reopening the
 *     banner via the footer's [data-cookie-preferences] button.
 *   - No stored choice → the banner shows; ignoring it leaves Consent Mode's
 *     denied default in force, so GA collects nothing.
 *
 * The banner is position: fixed, so it never shifts page content.
 */
---

<div class="cookie-banner" data-cookie-banner hidden role="region" aria-label="Cookie consent">
  <div class="cookie-banner__card">
    <div class="cookie-banner__copy">
      <p class="cookie-banner__text">
        We use essential cookies to make our site work. With your consent, we may also use
        analytics cookies to understand how visitors use our site. By clicking "Accept," you agree
        to our website's cookie use as described in our <a href="/cookie-policy">Cookie Policy</a>.
        You can change your cookie choice at any time using the "Cookie preferences" link in the
        footer.
      </p>
    </div>
    <div class="cookie-banner__actions">
      <!-- Accept and Decline are deliberately identical in weight, size, and
           color: consent guidance (EDPB/CNIL) expects rejecting to be no
           harder, and no less prominent, than accepting. -->
      <button type="button" class="btn btn--solid" data-consent-accept>Accept</button>
      <button type="button" class="btn btn--solid" data-consent-reject>Decline</button>
    </div>
    <button
      type="button"
      class="cookie-banner__close"
      data-consent-close
      aria-label="Close and keep my current choice"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  // Keep key, stored shape, and TTL in sync with the consent bootstrap
  // snippet in BaseLayout.astro.
  const CONSENT_KEY = 'handsful_cookie_consent';
  // Consent expires after 12 months (~365 days) — the Cookie Policy promises
  // "Up to 12 months, after which we ask again".
  const CONSENT_TTL_MS = 365 * 24 * 60 * 60 * 1000;

  const banner = document.querySelector<HTMLElement>('[data-cookie-banner]')!;
  const accept = banner.querySelector<HTMLButtonElement>('[data-consent-accept]')!;
  const reject = banner.querySelector<HTMLButtonElement>('[data-consent-reject]')!;
  const close = banner.querySelector<HTMLButtonElement>('[data-consent-close]')!;

  // localStorage throws in some private modes — treat that, an unparsable
  // value (e.g. the pre-expiry bare-string format), or an expired timestamp
  // as "no choice": the banner shows and the denied default protects the
  // visitor until they choose again.
  function readChoice(): 'granted' | 'denied' | null {
    try {
      const parsed = JSON.parse(localStorage.getItem(CONSENT_KEY) ?? 'null');
      if (
        parsed &&
        (parsed.value === 'granted' || parsed.value === 'denied') &&
        Date.now() - Date.parse(parsed.timestamp) <= CONSENT_TTL_MS
      ) {
        return parsed.value;
      }
    } catch {
      /* fall through to null */
    }
    return null;
  }
  function storeChoice(value: 'granted' | 'denied') {
    try {
      localStorage.setItem(
        CONSENT_KEY,
        JSON.stringify({ value, timestamp: new Date().toISOString() }),
      );
    } catch {
      /* choice just won't persist */
    }
  }

  // Queue the consent command even if gtag.js hasn't loaded (or never loads —
  // pushes are harmless when PUBLIC_GA_MEASUREMENT_ID is unset).
  function updateConsent(state: 'granted' | 'denied') {
    const dataLayer = (window.dataLayer = window.dataLayer || []);
    window.gtag =
      window.gtag ||
      function () {
        // eslint-disable-next-line prefer-rest-params -- gtag.js expects Arguments objects
        dataLayer.push(arguments);
      };
    window.gtag('consent', 'update', { analytics_storage: state });
  }

  // GA cookies linger after consent is withdrawn unless removed — the Cookie
  // Policy promises "only essential cookies" once a visitor declines.
  function clearGaCookies() {
    const expired = '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
    const registrable = location.hostname.split('.').slice(-2).join('.');
    document.cookie.split(';').forEach((entry) => {
      const name = entry.split('=')[0].trim();
      if (!name.startsWith('_ga')) return;
      document.cookie = name + expired;
      document.cookie = `${name}${expired}; domain=.${location.hostname}`;
      document.cookie = `${name}${expired}; domain=.${registrable}`;
    });
  }

  function openBanner(reopened: boolean) {
    // The close button only appears when a prior choice exists to fall back to.
    banner.dataset.canClose = String(reopened && readChoice() !== null);
    banner.hidden = false;
    if (reopened) accept.focus();
  }
  function closeBanner() {
    banner.hidden = true;
  }

  accept.addEventListener('click', () => {
    storeChoice('granted');
    updateConsent('granted');
    closeBanner();
  });
  reject.addEventListener('click', () => {
    storeChoice('denied');
    updateConsent('denied');
    clearGaCookies();
    closeBanner();
  });
  close.addEventListener('click', closeBanner);
  banner.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && banner.dataset.canClose === 'true') closeBanner();
  });

  // Footer "Cookie preferences" (and any future [data-cookie-preferences]
  // trigger) reopens the banner so the choice can be changed at any time.
  document.querySelectorAll('[data-cookie-preferences]').forEach((el) =>
    el.addEventListener('click', (event) => {
      event.preventDefault();
      openBanner(true);
    }),
  );

  // The hero intro owns the page's first moments (its CSS-only sequence has
  // no completion event to hook; the content stagger finishes around 5.9s),
  // so hold the first-visit banner back rather than competing with it.
  // Visual timing only — Consent Mode's denied default applies from document
  // start regardless of when the banner appears.
  const SHOW_DELAY_MS = 6000;

  if (readChoice() === null) {
    setTimeout(() => {
      // Re-check both: the visitor may have opened the banner via the footer
      // link and/or already made a choice while the delay ran.
      if (readChoice() === null && banner.hidden) openBanner(false);
    }, SHOW_DELAY_MS);
  }
</script>

<style>
  .cookie-banner {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: var(--z-cookie-banner); /* above page content, below the skip link */
    padding: var(--space-4);
    pointer-events: none; /* the card, not the full-width strip, takes clicks */
  }
  .cookie-banner[hidden] {
    display: none;
  }
  .cookie-banner__card {
    /* Restarts on every unhide (display: none → flex re-triggers it), so both
       the delayed first-visit appearance and the footer reopen ease in rather
       than popping. Reduced-motion users get an instant show via the global
       duration-zeroing rule. */
    animation: cookie-banner-enter 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    pointer-events: auto;
    position: relative;
    margin-inline: auto;
    max-width: 720px;
    /* Copy stacked above the actions at every width — the buttons never sit
       beside the text. */
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--ink);
    color: var(--warm-bg);
    border-radius: var(--radius-lg);
    box-shadow: 0 12px 32px rgba(34, 32, 29, 0.35);
  }
  /* The close button is absolutely positioned in the card's top-right corner.
     When it's showing, keep the copy clear of it — otherwise the first line
     runs underneath it once the copy wraps to the card's full width. */
  .cookie-banner[data-can-close='true'] .cookie-banner__copy {
    padding-right: 40px;
  }
  .cookie-banner__text {
    font-size: 15px;
    line-height: 22px;
    color: rgba(250, 247, 242, 0.85);
  }
  .cookie-banner__text a {
    color: var(--warm-bg);
  }
  .cookie-banner__text a:hover {
    color: var(--butter);
  }
  .cookie-banner__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
  /* Equal width too, so neither choice reads as the default. */
  .cookie-banner__actions .btn {
    min-width: 132px;
  }
  .cookie-banner__close {
    display: none;
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: none;
    border: 0;
    border-radius: 50%;
    color: rgba(250, 247, 242, 0.7);
    cursor: pointer;
  }
  .cookie-banner__close:hover {
    color: var(--warm-bg);
    background: rgba(250, 247, 242, 0.08);
  }
  .cookie-banner__close:focus-visible {
    outline: 3px solid var(--butter);
    outline-offset: 2px;
  }
  .cookie-banner[data-can-close='true'] .cookie-banner__close {
    display: inline-flex;
  }
  @keyframes cookie-banner-enter {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @media (max-width: 480px) {
    .cookie-banner {
      padding: var(--space-2);
    }
    .cookie-banner__actions {
      width: 100%;
    }
    .cookie-banner__actions .btn {
      flex: 1 1 0; /* basis 0, not auto: equal halves regardless of label length */
    }
  }
</style>
