---
import WaitlistCta from '../components/WaitlistCta.astro';
import { TAGLINE_LINES, HEADLINE } from '../config';
---

<!-- Signature gradient hero with a living coral accent. Copy stays short
     per the "never behind long text" rule; headline is large-text white per
     the brand's accessible-pairings table. The app mock lives in the "See
     it in action" section below, so the hero stays uncrowded and the
     gradient + copy carry it.

     Intro (plays once per page load): a leisurely fade-in of the copy,
     straight onto the gradient — no overlay, so the gradient and glows are
     there from the first frame. (Replaced the earlier blob-chase overlay
     sequence, 2026-07-15 — Kayla's call: simpler read, same warmth.)
       0.3–1.3s  tagline fades up into its slot,
       1.2–2.3s  headline follows — its delay (1.2s) is the page's LCP
                 anchor; keep it ≤1.5s,
       2.3–3.5s  the waitlist form completes the stagger (~3.5s total).
     The header and the sections below the hero are deliberately NOT
     animated or delayed: they paint immediately, whatever the copy fade is
     doing.

     Ambient state (runs indefinitely): a lava lamp. Five soft regions —
     coral top-right, a dimmer coral top-left, butter bottom-right and
     mid-left, and a faint sky bloom in the bottom-left corner — each
     wander a closed multi-waypoint path with asymmetric squish
     (scale(x, y) per waypoint, like a lava blob elongating as it floats),
     on different periods and offsets so the field never repeats visibly.
     All of them share one 4s breathing pulse on their parent: independent
     motions, one shared rhythm, same as the babies the product tracks.
     Transform/opacity only; radial-gradient falloff, no blur filters, so
     it's compositor-cheap.

     BRAND NOTE: coral inside the hero gradient is a deliberate extension of
     the signature 3-stop, approved by Kayla (2026-07-06). The copy is
     CENTERED (Kayla's call, 2026-07-06), so the glows are pinned to the
     top-right/bottom-right corners with restrained sweep — white copy must
     never sit on meaningful coral/butter (their white-text contrast is too
     low; same corner rule the butter stop already follows).

     prefers-reduced-motion: no fade, no drift — straight to the static
     hero with the glows present but still. -->
<section class="hero" id="waitlist">
  <div class="hero__ambient" aria-hidden="true">
    <div class="hero__glow hero__glow--coral"></div>
    <div class="hero__glow hero__glow--coral2"></div>
    <div class="hero__glow hero__glow--butter"></div>
    <div class="hero__glow hero__glow--sky"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <!-- The tagline's sentences (src/copy.mjs) with a presentational line
           break between them; SITE.tagline is the same words on one line. -->
      <p class="hero__eyebrow">
        {TAGLINE_LINES.map((line, i) => (i > 0 ? <><br />{line}</> : line))}
      </p>
      <h1 class="hero__title">{HEADLINE}</h1>
      <!-- No subhead: the hero stays sparse (tagline + headline + form);
           the one-tap pitch lives in "See it in action" below. -->
      <WaitlistCta variant="on-gradient" formId="waitlist-email-hero" source="hero" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--gradient-signature);
    color: #fff;
    /* Clips the ambient glows sweeping past the edges */
    overflow: hidden;
  }
  .hero__inner {
    /* Above the ambient glows */
    position: relative;
    padding-block: clamp(var(--space-16), 11vw, calc(var(--space-24) + var(--space-8)));
  }
  /* Centered hero copy (Kayla's call): every block centers itself, and the
     form (a child component) is centered via the :global margin rule. */
  .hero__copy {
    text-align: center;
  }
  .hero__copy > :global(*) {
    margin-inline: auto;
  }
  .hero__eyebrow {
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--butter);
    margin-bottom: var(--space-4);
  }
  .hero__title {
    color: #fff;
    max-width: 18ch;
    margin-bottom: var(--space-8);
  }

  /* ---- Ambient warm regions (permanent) ------------------------------ */

  .hero__ambient {
    position: absolute;
    inset: 0;
    /* The shared rhythm: one breath for both glows… */
    animation: ambient-breathe 4s ease-in-out infinite;
  }
  .hero__glow {
    position: absolute;
    aspect-ratio: 1;
    will-change: transform;
  }
  /* …while each drifts to its own slow, offset cycle. Both hug the right
     edge, clear of the white copy (contrast rule — see brand note above). */
  .hero__glow--coral {
    width: clamp(420px, 48vw, 760px);
    top: -22%;
    right: -16%;
    background: radial-gradient(
      closest-side,
      rgba(255, 115, 87, 0.62),
      rgba(255, 115, 87, 0) 70%
    );
    animation:
      glow-appear 0.9s ease 0.2s both,
      drift-coral 11s ease-in-out -4s infinite;
  }
  /* Second coral, top-left: dimmer sibling of the main coral so the warm
     color frames both sides. Its sweep heads down-right into the teal but
     stays shy of the centered headline's left edge. */
  .hero__glow--coral2 {
    width: clamp(340px, 36vw, 600px);
    top: -16%;
    left: -14%;
    background: radial-gradient(
      closest-side,
      rgba(255, 115, 87, 0.42),
      rgba(255, 115, 87, 0) 70%
    );
    animation:
      glow-appear 0.9s ease 0.5s both,
      drift-coral2 13s ease-in-out -6s infinite;
  }
  .hero__glow--butter {
    width: clamp(360px, 40vw, 640px);
    bottom: -30%;
    right: -8%;
    background: radial-gradient(
      closest-side,
      rgba(255, 203, 87, 0.52),
      rgba(255, 203, 87, 0) 70%
    );
    animation:
      glow-appear 0.9s ease 0.35s both,
      drift-butter 15s ease-in-out -10s infinite;
  }
  /* Faint cool bloom, pinned to the bottom-left corner: its meaningful
     color must stay below/left of the centered form (white small text over
     a sky-lightened teal would drop under AA). */
  .hero__glow--sky {
    width: clamp(340px, 38vw, 600px);
    bottom: -32%;
    left: -14%;
    background: radial-gradient(
      closest-side,
      rgba(62, 166, 194, 0.45),
      rgba(62, 166, 194, 0) 70%
    );
    animation:
      glow-appear 0.9s ease 0.65s both,
      drift-sky 17s ease-in-out -7s infinite;
  }

  @keyframes ambient-breathe {
    0%,
    100% {
      transform: scale(0.97);
    }
    50% {
      transform: scale(1.03);
    }
  }
  @keyframes glow-appear {
    from {
      opacity: 0;
    }
  }
  /* Lava-lamp wander: closed multi-waypoint loops (not a two-point
     alternate, which reads as a metronome) with asymmetric scale(x, y)
     squish so each blob elongates and settles as it floats. Travel and
     tempo are deliberately assertive (roughly double the original sweep,
     11–17s loops) so the drift reads at a glance instead of demanding a
     stare — but sweeps toward the teal stay capped: meaningful color must
     remain clear of the centered text column (the falloff hits 0 at 70%
     radius, so only the faint outer half approaches it). Different periods
     + offsets keep the four from ever aligning. */
  @keyframes drift-coral {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1, 1);
    }
    30% {
      transform: translate3d(-16%, 20%, 0) scale(1.2, 0.9);
    }
    60% {
      transform: translate3d(-24%, 7%, 0) scale(1.32, 1.12);
    }
    80% {
      transform: translate3d(-8%, -15%, 0) scale(0.95, 1.26);
    }
  }
  @keyframes drift-coral2 {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1, 1);
    }
    35% {
      transform: translate3d(15%, 17%, 0) scale(1.22, 0.92);
    }
    65% {
      transform: translate3d(21%, 4%, 0) scale(1.06, 1.3);
    }
    85% {
      transform: translate3d(6%, -12%, 0) scale(1.28, 0.96);
    }
  }
  @keyframes drift-butter {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1, 1);
    }
    25% {
      transform: translate3d(-18%, -16%, 0) scale(1.25, 0.86);
    }
    55% {
      transform: translate3d(-8%, -28%, 0) scale(1, 1.32);
    }
    75% {
      transform: translate3d(14%, -11%, 0) scale(1.28, 1.04);
    }
  }
  @keyframes drift-sky {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1, 1);
    }
    40% {
      transform: translate3d(15%, -21%, 0) scale(1.3, 0.95);
    }
    70% {
      transform: translate3d(24%, -6%, 0) scale(0.9, 1.32);
    }
  }

  @media (max-width: 800px) {
    /* Phones: the hero owns the visible screen (svh ignores the URL-bar
       dance) with the copy vertically centered — otherwise the content
       hugs the top and the tagline's center-stage moment can land under
       browser chrome / the cookie banner on short viewports. */
    .hero__inner {
      min-height: calc(100vh - 80px); /* fallback; 80px ≈ sticky header */
      min-height: calc(100svh - 80px);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    /* Narrow screens: copy spans the full width, so push the glows further
       off-canvas — color stays visible at the edges, never behind text. */
    .hero__glow--coral {
      right: -35%;
    }
    .hero__glow--coral2 {
      left: -32%;
    }
    .hero__glow--butter {
      right: -25%;
    }
    .hero__glow--sky {
      left: -30%;
    }
  }

  /* ---- Copy fade-in (one-time) -----------------------------------------
     Leisurely tagline → headline → form stagger, ~3.5s total, straight onto
     the gradient. :global() because .hero__copy's children include the
     WaitlistCta form, which doesn't carry this component's scope attribute. */

  .hero__copy > :global(*) {
    animation: hero-reveal 1s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
  }
  /* The headline. Its delay is the page's LCP floor — keep it ≤1.5s. */
  .hero__copy > :global(*:nth-child(2)) {
    animation-delay: 1.2s;
    animation-duration: 1.1s;
  }
  .hero__copy > :global(*:nth-child(3)) {
    animation-delay: 2.3s;
    animation-duration: 1.2s;
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* Skip the fade and still the glows: straight to the finished hero.
     Needed explicitly — global.css only zeroes animation *durations*, which
     would leave the reveal delays as seconds of invisible content. */
  @media (prefers-reduced-motion: reduce) {
    .hero__ambient,
    .hero__glow,
    .hero__copy > :global(*) {
      animation: none;
    }
  }
</style>
