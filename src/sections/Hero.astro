---
import WaitlistCta from '../components/WaitlistCta.astro';
---

<!-- Signature gradient hero with a one-time blob intro and a living coral
     accent. Copy stays short per the "never behind long text" rule; headline
     is large-text white per the brand's accessible-pairings table. The app
     mock lives in the "See it in action" section below, so the hero stays
     uncrowded and the gradient + copy carry it.

     Intro ("Blob Chase → Gradient Reveal", plays once per page load):
       0–1.8s  the two sibling blobs CHASE each other, follow-the-leader
               style: they spring apart onto a wide shared track (a spread
               layer pushes each outward and shrinks it) and lap it once,
               unhurried and upright — an inner keel cancels the orbit
               rotation — B on a faster-starting curve so it visibly closes
               on A before both bleed speed and flow back together. They
               wobble lava-lamp style the whole way around (continuous
               `d: path()` morphs between matched-point variants from
               scripts/generate-blobs.mjs, a shape change every ~0.5s).
       1.2–2.7s the lap's momentum flings them into DISPERSAL rather than
               one conquering: Blob A scales ×15 (ease-in, clipped by the
               hero) while Blob B swells ×7, blurs, and evaporates on top
               of it — and the overlay starts crossfading mid-growth
               (2.1–3.0s), so both blobs melt into the real gradient while
               still moving. A brief coral-free breath follows…
       2.7–4.1s …then coral re-emerges into the hero as the ambient glow
               (butter and a faint sky glow follow), where Blob B died.
       3.0–3.5s the sticky header (hidden until now — see the is:global
               style block) slides down once the gradient has filled.
       2.8–3.6s the tagline fades in DEAD-CENTER on the settled gradient
               (vertically + horizontally, all viewports) at ~1.9× size —
               the brand speaks first, for a beat…
       3.6–4.8s …then rises to its slot at the top of the centered copy
               block, shrinking into its docked eyebrow size,
       4.2–5.9s while headline → form stagger in beneath it, an unhurried
               0.7s apart.

     Ambient state (after the intro, runs indefinitely): a lava lamp. Four
     soft regions — coral top-right (Blob B's resting place), a second
     dimmer coral top-left, butter bottom-right, and a faint sky bloom in
     the bottom-left corner — each wander a closed multi-waypoint path with
     asymmetric squish
     (scale(x, y) per waypoint, like a lava blob elongating as it floats),
     on different periods and offsets so the field never repeats visibly.
     All three share one 4s breathing pulse on their parent: independent
     motions, one shared rhythm, same as the babies the product tracks.
     Transform/opacity only; radial-gradient falloff, no blur filters, so
     it's compositor-cheap.

     BRAND NOTE: coral inside the hero gradient is a deliberate extension of
     the signature 3-stop, approved by Kayla (2026-07-06). The copy is
     CENTERED (Kayla's call, 2026-07-06), so the glows are pinned to the
     top-right/bottom-right corners with restrained sweep — white copy must
     never sit on meaningful coral/butter (their white-text contrast is too
     low; same corner rule the butter stop already follows).

     prefers-reduced-motion: no intro, no drift — straight to the static
     hero with the coral glow present but still. -->
<section class="hero" id="waitlist">
  <div class="hero__ambient" aria-hidden="true">
    <div class="hero__glow hero__glow--coral"></div>
    <div class="hero__glow hero__glow--coral2"></div>
    <div class="hero__glow hero__glow--butter"></div>
    <div class="hero__glow hero__glow--sky"></div>
  </div>

  <div class="hero__intro" aria-hidden="true">
    <svg class="hero__intro-blobs" viewBox="0 0 640 520" fill="none" role="presentation">
      <defs>
        <!-- Signature gradient, transcribed from --gradient-signature (160deg) -->
        <linearGradient id="hero-intro-grad-a" x1="0.15" y1="0" x2="0.75" y2="1">
          <stop offset="0" stop-color="#3ea6c2"></stop>
          <stop offset="0.55" stop-color="#2f7d6b"></stop>
          <stop offset="1" stop-color="#ffcb57"></stop>
        </linearGradient>
        <!-- Sibling palette: Coral → Teal-green -->
        <linearGradient id="hero-intro-grad-b" x1="0.2" y1="0.05" x2="0.7" y2="1">
          <stop offset="0" stop-color="#ff7357"></stop>
          <stop offset="1" stop-color="#2f7d6b"></stop>
        </linearGradient>
      </defs>
      <!-- A first, B second: B stays on top while A takes over beneath it,
           so B visibly melts into the new background instead of being
           swallowed by it. Four nested layers per blob because animations
           can't share one element's `transform`: the orbit <g> carries the
           blob around the shared track, the spread <g> pushes it outward
           onto a wider lane (and shrinks it) so the pair circles clearly
           separated, the keel <g> counter-rotates so the blob travels
           upright instead of pinwheeling, and the path keeps the
           takeover/dissolve. -->
      <g class="hero__intro-orbit hero__intro-orbit--a">
        <g class="hero__intro-spread hero__intro-spread--a">
          <g class="hero__intro-keel hero__intro-keel--a">
            <path
              class="hero__intro-blob hero__intro-blob--a"
              fill="url(#hero-intro-grad-a)"
              d="M394.9 250.8 C395.6 286.0 375.6 344.2 345.0 370.5 C314.5 396.8 245.1 406.8 211.5 408.6 C177.9 410.4 165.5 408.8 143.5 381.2 C121.5 353.6 85.5 285.5 79.7 243.0 C73.8 200.4 83.7 152.5 108.7 125.8 C133.6 99.0 190.7 76.9 229.4 82.5 C268.1 88.0 313.3 131.1 340.9 159.1 C368.5 187.2 394.2 215.5 394.9 250.8 Z"
            ></path>
          </g>
        </g>
      </g>
      <g class="hero__intro-orbit hero__intro-orbit--b">
        <g class="hero__intro-spread hero__intro-spread--b">
          <g class="hero__intro-keel hero__intro-keel--b">
            <path
              class="hero__intro-blob hero__intro-blob--b"
              fill="url(#hero-intro-grad-b)"
              d="M555.4 293.8 C555.6 323.0 556.8 355.8 538.9 376.8 C521.0 397.8 479.4 420.6 448.0 419.9 C416.5 419.2 371.0 390.3 350.1 372.6 C329.2 354.8 320.7 337.8 322.6 313.2 C324.5 288.7 341.8 248.4 361.6 225.4 C381.3 202.4 411.8 179.2 441.1 175.3 C470.4 171.3 518.3 182.0 537.4 201.8 C556.4 221.5 555.1 264.7 555.4 293.8 Z"
            ></path>
          </g>
        </g>
      </g>
    </svg>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <!-- SITE.tagline, hardcoded here for the presentational line break —
           keep the words in sync with src/config.ts -->
      <p class="hero__eyebrow">You've got your hands full.<br />We've got you.</p>
      <h1 class="hero__title">The baby tracker built for twins, triplets&nbsp;&amp;&nbsp;more</h1>
      <!-- No subhead: the hero stays sparse (tagline + headline + form);
           the one-tap pitch lives in "See it in action" below. -->
      <WaitlistCta variant="on-gradient" formId="waitlist-email-hero" source="hero" />
    </div>
  </div>
</section>

<script>
  // Measures how far the tagline's stage entrance (hero dead-center) is from
  // its laid-out slot, and hands the offset to the CSS animation via
  // --tagline-stage-y. Runs once at load: the stage moment is over within
  // seconds, so a mid-intro resize isn't worth handling. Suspend the
  // element's animations while measuring (they win over inline styles), and
  // note the reveal keeps the tagline invisible until 2.8s, so this can't
  // cause a flash.
  const hero = document.querySelector<HTMLElement>('.hero');
  const tagline = document.querySelector<HTMLElement>('.hero__eyebrow');
  if (hero && tagline && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    tagline.style.animation = 'none';
    tagline.style.transform = 'none';
    const heroBox = hero.getBoundingClientRect();
    const slotBox = tagline.getBoundingClientRect();
    tagline.style.animation = '';
    tagline.style.transform = '';
    const dy = heroBox.top + heroBox.height / 2 - (slotBox.top + slotBox.height / 2);
    tagline.style.setProperty('--tagline-stage-y', `${Math.round(dy)}px`);
  }
</script>

<style>
  .hero {
    position: relative;
    background: var(--gradient-signature);
    color: #fff;
    /* Also what clips Blob A as it scales past the edges */
    overflow: hidden;
  }
  .hero__inner {
    /* Above the ambient glows; the intro overlay (z-index 2) still wins */
    position: relative;
    padding-block: clamp(var(--space-16), 11vw, calc(var(--space-24) + var(--space-8)));
  }
  /* Centered hero copy (Kayla's call): every block centers itself, and the
     form (a child component) is centered via the :global margin rule. */
  .hero__copy {
    text-align: center;
  }
  .hero__copy > :global(*) {
    margin-inline: auto;
  }
  .hero__eyebrow {
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--butter);
    margin-bottom: var(--space-4);
  }
  .hero__title {
    color: #fff;
    max-width: 18ch;
    margin-bottom: var(--space-8);
  }

  /* ---- Ambient warm regions (permanent) ------------------------------ */

  .hero__ambient {
    position: absolute;
    inset: 0;
    /* The shared rhythm: one breath for both glows… */
    animation: ambient-breathe 4s ease-in-out infinite;
  }
  .hero__glow {
    position: absolute;
    aspect-ratio: 1;
    will-change: transform;
  }
  /* …while each drifts to its own slow, offset cycle. Both hug the right
     edge, clear of the white copy (contrast rule — see brand note above). */
  .hero__glow--coral {
    width: clamp(420px, 48vw, 760px);
    top: -22%;
    right: -16%;
    background: radial-gradient(
      closest-side,
      rgba(255, 115, 87, 0.62),
      rgba(255, 115, 87, 0) 70%
    );
    animation:
      glow-appear 1.1s ease 2.7s both,
      drift-coral 11s ease-in-out -4s infinite;
  }
  /* Second coral, top-left: dimmer sibling of the main coral so the warm
     color frames both sides. Its sweep heads down-right into the teal but
     stays shy of the centered headline's left edge. */
  .hero__glow--coral2 {
    width: clamp(340px, 36vw, 600px);
    top: -16%;
    left: -14%;
    background: radial-gradient(
      closest-side,
      rgba(255, 115, 87, 0.42),
      rgba(255, 115, 87, 0) 70%
    );
    animation:
      glow-appear 1.1s ease 3.1s both,
      drift-coral2 13s ease-in-out -6s infinite;
  }
  .hero__glow--butter {
    width: clamp(360px, 40vw, 640px);
    bottom: -30%;
    right: -8%;
    background: radial-gradient(
      closest-side,
      rgba(255, 203, 87, 0.52),
      rgba(255, 203, 87, 0) 70%
    );
    animation:
      glow-appear 1.1s ease 3s both,
      drift-butter 15s ease-in-out -10s infinite;
  }
  /* Faint cool bloom, pinned to the bottom-left corner: its meaningful
     color must stay below/left of the centered form (white small text over
     a sky-lightened teal would drop under AA). */
  .hero__glow--sky {
    width: clamp(340px, 38vw, 600px);
    bottom: -32%;
    left: -14%;
    background: radial-gradient(
      closest-side,
      rgba(62, 166, 194, 0.45),
      rgba(62, 166, 194, 0) 70%
    );
    animation:
      glow-appear 1.1s ease 3.3s both,
      drift-sky 17s ease-in-out -7s infinite;
  }

  @keyframes ambient-breathe {
    0%,
    100% {
      transform: scale(0.97);
    }
    50% {
      transform: scale(1.03);
    }
  }
  @keyframes glow-appear {
    from {
      opacity: 0;
    }
  }
  /* Lava-lamp wander: closed multi-waypoint loops (not a two-point
     alternate, which reads as a metronome) with asymmetric scale(x, y)
     squish so each blob elongates and settles as it floats. Travel and
     tempo are deliberately assertive (roughly double the original sweep,
     11–17s loops) so the drift reads at a glance instead of demanding a
     stare — but sweeps toward the teal stay capped: meaningful color must
     remain clear of the centered text column (the falloff hits 0 at 70%
     radius, so only the faint outer half approaches it). Different periods
     + offsets keep the four from ever aligning. */
  @keyframes drift-coral {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1, 1);
    }
    30% {
      transform: translate3d(-16%, 20%, 0) scale(1.2, 0.9);
    }
    60% {
      transform: translate3d(-24%, 7%, 0) scale(1.32, 1.12);
    }
    80% {
      transform: translate3d(-8%, -15%, 0) scale(0.95, 1.26);
    }
  }
  @keyframes drift-coral2 {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1, 1);
    }
    35% {
      transform: translate3d(15%, 17%, 0) scale(1.22, 0.92);
    }
    65% {
      transform: translate3d(21%, 4%, 0) scale(1.06, 1.3);
    }
    85% {
      transform: translate3d(6%, -12%, 0) scale(1.28, 0.96);
    }
  }
  @keyframes drift-butter {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1, 1);
    }
    25% {
      transform: translate3d(-18%, -16%, 0) scale(1.25, 0.86);
    }
    55% {
      transform: translate3d(-8%, -28%, 0) scale(1, 1.32);
    }
    75% {
      transform: translate3d(14%, -11%, 0) scale(1.28, 1.04);
    }
  }
  @keyframes drift-sky {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1, 1);
    }
    40% {
      transform: translate3d(15%, -21%, 0) scale(1.3, 0.95);
    }
    70% {
      transform: translate3d(24%, -6%, 0) scale(0.9, 1.32);
    }
  }

  @media (max-width: 800px) {
    /* Phones: the hero owns the visible screen (svh ignores the URL-bar
       dance) with the copy vertically centered — otherwise the content
       hugs the top and the tagline's center-stage moment can land under
       browser chrome / the cookie banner on short viewports. */
    .hero__inner {
      min-height: calc(100vh - 80px); /* fallback; 80px ≈ sticky header */
      min-height: calc(100svh - 80px);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    /* Narrow screens: copy spans the full width, so push the glows further
       off-canvas — color stays visible at the edges, never behind text. */
    .hero__glow--coral {
      right: -35%;
    }
    .hero__glow--coral2 {
      left: -32%;
    }
    .hero__glow--butter {
      right: -25%;
    }
    .hero__glow--sky {
      left: -30%;
    }
  }

  /* ---- Intro overlay (one-time) --------------------------------------- */

  .hero__intro {
    /* Morph targets from scripts/generate-blobs.mjs — regenerate there,
       don't hand-edit (variants must keep one command structure to tween). */
    --blob-a-0: path('M394.9 250.8 C395.6 286.0 375.6 344.2 345.0 370.5 C314.5 396.8 245.1 406.8 211.5 408.6 C177.9 410.4 165.5 408.8 143.5 381.2 C121.5 353.6 85.5 285.5 79.7 243.0 C73.8 200.4 83.7 152.5 108.7 125.8 C133.6 99.0 190.7 76.9 229.4 82.5 C268.1 88.0 313.3 131.1 340.9 159.1 C368.5 187.2 394.2 215.5 394.9 250.8 Z');
    --blob-a-1: path('M379.6 230.4 C384.2 264.7 371.6 326.1 346.7 352.3 C321.8 378.5 268.8 386.4 230.2 387.7 C191.7 388.9 144.3 382.0 115.5 360.1 C86.8 338.2 55.6 297.3 57.9 256.1 C60.2 214.9 101.9 141.4 129.3 113.0 C156.7 84.6 190.7 80.0 222.4 85.5 C254.0 91.0 293.1 121.9 319.3 146.0 C345.5 170.2 375.0 196.0 379.6 230.4 Z');
    --blob-a-2: path('M418.6 268.6 C419.4 307.8 374.3 317.7 341.1 339.4 C308.0 361.1 257.0 395.2 219.7 399.0 C182.4 402.9 137.9 390.5 117.6 362.3 C97.3 334.1 95.8 272.2 97.9 230.0 C100.0 187.7 108.4 127.4 130.2 108.8 C152.0 90.1 194.3 118.7 228.6 118.0 C262.9 117.3 304.4 79.6 336.1 104.7 C367.7 129.8 417.7 229.5 418.6 268.6 Z');
    --blob-b-0: path('M555.4 293.8 C555.6 323.0 556.8 355.8 538.9 376.8 C521.0 397.8 479.4 420.6 448.0 419.9 C416.5 419.2 371.0 390.3 350.1 372.6 C329.2 354.8 320.7 337.8 322.6 313.2 C324.5 288.7 341.8 248.4 361.6 225.4 C381.3 202.4 411.8 179.2 441.1 175.3 C470.4 171.3 518.3 182.0 537.4 201.8 C556.4 221.5 555.1 264.7 555.4 293.8 Z');
    --blob-b-1: path('M562.3 302.3 C565.6 332.8 553.8 373.2 532.5 388.6 C511.3 404.1 465.8 395.5 434.6 395.1 C403.5 394.6 365.2 406.2 345.8 385.8 C326.3 365.4 312.1 302.1 317.9 272.6 C323.6 243.1 355.4 230.5 380.2 208.8 C405.0 187.1 444.5 142.9 466.6 142.4 C488.8 141.9 497.1 179.2 513.0 205.9 C529.0 232.5 559.1 271.9 562.3 302.3 Z');
    --blob-b-2: path('M557.3 281.5 C558.8 309.3 565.2 332.6 546.3 352.4 C527.3 372.2 473.8 394.8 443.5 400.2 C413.2 405.7 384.6 405.3 364.4 385.1 C344.2 365.0 324.0 306.5 322.3 279.2 C320.7 251.9 336.5 243.4 354.4 221.3 C372.4 199.2 399.6 152.7 430.1 146.8 C460.6 140.8 516.3 163.1 537.5 185.6 C558.7 208.0 555.9 253.7 557.3 281.5 Z');

    position: absolute;
    inset: 0;
    /* Above hero content until it fades; below the sticky header and cookie
       banner (see the --z-* tokens in global.css). */
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    background: var(--warm-bg);
    pointer-events: none;
    animation: intro-vanish 0.9s ease 2.1s both;
  }

  .hero__intro-blobs {
    width: min(400px, 68%);
    height: auto;
    margin-top: clamp(32px, 10vh, 110px);
    /* Let the blobs grow past the small SVG canvas; .hero clips instead */
    overflow: visible;
  }

  /* The chase: follow-the-leader on one shared loop. The orbit groups spin
     two full turns around the view-box center, which carries the blobs
     (opposite sides of that center) around the same circular track — and
     the keel inside each orbit counter-rotates by the exact same curve, so
     the blobs travel the track UPRIGHT. Without the keels this reads as a
     rigid pinwheel: shapes and gradients spinning around one visible
     anchor. Different easing curves per blob are the pursuit: B jumps out
     fast and closes most of the half-lap gap on A before A pulls away
     late. Both curves end long and flat, so the loop bleeds momentum right
     as the takeover (1s) flings the blobs outward — the dispersal looks
     thrown, not scheduled. Keels use fill-box, so each counter-rotates
     about its own (orbiting) blob center; A and B keyframe pairs must keep
     matching beziers or the cancellation drifts. */
  .hero__intro-orbit,
  .hero__intro-spread,
  .hero__intro-keel {
    will-change: transform;
  }
  .hero__intro-orbit {
    transform-box: view-box;
    transform-origin: center;
  }
  .hero__intro-spread,
  .hero__intro-keel {
    transform-box: fill-box;
    transform-origin: center;
  }
  .hero__intro-orbit--a {
    animation: intro-chase 1.8s cubic-bezier(0.6, 0.02, 0.15, 1) both;
  }
  .hero__intro-spread--a {
    animation: intro-spread-a 1.8s ease-in-out both;
  }
  .hero__intro-keel--a {
    animation: intro-chase-counter 1.8s cubic-bezier(0.6, 0.02, 0.15, 1) both;
  }
  .hero__intro-orbit--b {
    animation: intro-chase 1.8s cubic-bezier(0.3, 0.1, 0.28, 1) both;
  }
  .hero__intro-spread--b {
    animation: intro-spread-b 1.8s ease-in-out both;
  }
  .hero__intro-keel--b {
    animation: intro-chase-counter 1.8s cubic-bezier(0.3, 0.1, 0.28, 1) both;
  }

  .hero__intro-blob {
    transform-box: fill-box;
    transform-origin: center;
  }
  .hero__intro-blob--a {
    animation:
      intro-a-morph 2.6s ease-in-out both,
      intro-a-takeover 1.5s cubic-bezier(0.55, 0, 0.85, 0.45) 1.2s both;
    will-change: transform;
  }
  /* Blob B disperses: swells, blurs and evaporates on top of the growing
     gradient (still morphing all the while); coral then re-enters as
     .hero__glow--coral (2.7s). The blur ramp is what sells "dissolving
     into color" — it's a one-time 1.3s cost on a small element. */
  .hero__intro-blob--b {
    animation:
      intro-b-morph 2.6s ease-in-out both,
      intro-b-dissolve 1.3s cubic-bezier(0.42, 0, 1, 1) 1.4s both;
    will-change: transform, opacity, filter;
  }

  @keyframes intro-chase {
    from {
      transform: rotate(0deg);
    }
    to {
      /* One full lap — visually back where they started, so the dispersal
         grows from the same composition the intro opened with */
      transform: rotate(360deg);
    }
  }
  @keyframes intro-chase-counter {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(-360deg);
    }
  }
  /* The spread sits between orbit and keel, so its translate happens in
     the orbit's rotating frame: pushing each blob along its own
     center-to-blob axis widens the track radius for the whole lap. Paired
     with the shrink, the two circle clearly separated, then flow back
     together as the spin dies — right as the takeover starts merging them
     into the gradient. Vectors are each blob's outward unit axis × 65
     view-box units. */
  @keyframes intro-spread-a {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    22%,
    78% {
      transform: translate(-64px, -12px) scale(0.82);
    }
  }
  @keyframes intro-spread-b {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    22%,
    78% {
      transform: translate(64px, 12px) scale(0.82);
    }
  }
  @keyframes intro-vanish {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
  @keyframes intro-a-takeover {
    to {
      transform: scale(15);
    }
  }
  @keyframes intro-b-dissolve {
    from {
      filter: blur(0px);
    }
    to {
      transform: scale(7);
      opacity: 0;
      filter: blur(18px);
    }
  }
  /* Lava-lamp morphs: cycle the variants continuously (a shape change
     every ~0.5s instead of one long two-stop tween) so the blobs visibly
     wobble the whole way around the track. A and B run different variant
     orders so their wobbles never rhyme. */
  @keyframes intro-a-morph {
    0% {
      d: var(--blob-a-0);
    }
    20% {
      d: var(--blob-a-1);
    }
    40% {
      d: var(--blob-a-2);
    }
    60% {
      d: var(--blob-a-0);
    }
    80% {
      d: var(--blob-a-1);
    }
    100% {
      d: var(--blob-a-2);
    }
  }
  @keyframes intro-b-morph {
    0% {
      d: var(--blob-b-0);
    }
    20% {
      d: var(--blob-b-2);
    }
    40% {
      d: var(--blob-b-1);
    }
    60% {
      d: var(--blob-b-0);
    }
    80% {
      d: var(--blob-b-2);
    }
    100% {
      d: var(--blob-b-1);
    }
  }

  /* ---- Content reveal (intro phase 3) ---------------------------------
     :global() because .hero__copy's children include the WaitlistCta form,
     which doesn't carry this component's scope attribute. */

  .hero__copy > :global(*) {
    animation: hero-reveal 1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero__copy > :global(*:nth-child(2)) {
    animation-delay: 4.2s;
  }
  .hero__copy > :global(*:nth-child(3)) {
    animation-delay: 4.9s;
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* Tagline: the brand speaks first. Enters title-sized at the hero's
     dead center — horizontal centering comes from the copy's text-align;
     vertical centering is a transform offset (--tagline-stage-y) measured
     once by the script below, since percentage `top` on relative elements
     resolves against the wrong box in Chromium. It holds a beat, then
     rises to its slot while shrinking into the eyebrow it becomes.
     Transform-only, so nothing reflows; without JS the stage-y stays 0 and
     the tagline simply plays its beat in its slot (still centered
     horizontally). This rule sits after the .hero__copy > * reveal rule so
     its animation list wins. */
  .hero__eyebrow {
    --tagline-stage-scale: 1.9;
    --tagline-stage-y: 0px;
    display: inline-block;
    transform: translateY(var(--tagline-stage-y)) scale(var(--tagline-stage-scale));
    animation:
      tagline-enter 0.8s cubic-bezier(0.22, 1, 0.36, 1) 2.8s both,
      tagline-dock 1.2s cubic-bezier(0.65, 0, 0.35, 1) 3.6s both;
  }
  @keyframes tagline-enter {
    from {
      opacity: 0;
      transform: translateY(calc(var(--tagline-stage-y) + 14px))
        scale(var(--tagline-stage-scale));
    }
    to {
      opacity: 1;
      transform: translateY(var(--tagline-stage-y)) scale(var(--tagline-stage-scale));
    }
  }
  @keyframes tagline-dock {
    from {
      transform: translateY(var(--tagline-stage-y)) scale(var(--tagline-stage-scale));
    }
    to {
      transform: translateY(0px) scale(1);
    }
  }
  @media (max-width: 800px) {
    /* The line break keeps each line short, but 1.9× is still too wide for
       a 390px viewport — 1.4× reads as a title while keeping ~30px of
       breathing room to each edge. */
    .hero__eyebrow {
      --tagline-stage-scale: 1.4;
    }
  }

  /* Skip the intro and still the glows: straight to the finished hero.
     Needed explicitly — global.css only zeroes animation *durations*, which
     would leave the 2.45s+ reveal delays as seconds of invisible content. */
  @media (prefers-reduced-motion: reduce) {
    .hero__intro {
      display: none;
    }
    .hero__ambient,
    .hero__glow,
    .hero__copy > :global(*) {
      animation: none;
    }
    /* The tagline's resting styles are its centered stage position; with
       animations off it must be pinned to the docked state instead. */
    .hero__eyebrow {
      animation: none;
      transform: none;
    }
  }
</style>

<style is:global>
  /* Part of the hero intro, but reaching outside the component: the sticky
     header stays hidden while the blobs open, then slides down once the
     gradient has fully filled the hero (~2.4s, after the overlay crossfade
     completes). Global on purpose — Header.astro is rendered by the layout,
     but because this rule ships with Hero.astro it only exists on pages
     that have the hero (the landing page); the header appears instantly
     everywhere else. Delete alongside the intro. */
  .header {
    animation: header-reveal 0.5s cubic-bezier(0.22, 1, 0.36, 1) 3s both;
  }
  /* Same beat for everything else that peeks into the first paint: the
     sections below the hero (its siblings inside <main>) — otherwise they
     sit fully rendered next to a bare intro. */
  main > .hero ~ * {
    animation: header-reveal 0.5s cubic-bezier(0.22, 1, 0.36, 1) 3s both;
  }
  @keyframes header-reveal {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .header,
    main > .hero ~ * {
      animation: none;
    }
  }
</style>
