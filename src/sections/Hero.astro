---
import WaitlistCta from '../components/WaitlistCta.astro';
---

<!-- Signature gradient hero with a one-time blob intro and a living coral
     accent. Copy stays short per the "never behind long text" rule; headline
     is large-text white per the brand's accessible-pairings table. The app
     mock lives in the "See it in action" section below, so the hero stays
     uncrowded and the gradient + copy carry it.

     Intro ("Blob Intro → Gradient Reveal", plays once per page load):
       0–2s    two small sibling blobs morph (CSS `d: path()` between
               matched-point variants from scripts/generate-blobs.mjs)
       0.6–1.9s Blob A scales ×15, ease-in, clipped by the hero — its gradient
               becomes the background. Blob B (coral) swells and fades out
               completely while A takes over (gone by ~1.7s)…
       1.8–2.4s …the overlay crossfades away to the settled gradient — a
               breath with no coral at all…
       2.1–3.5s …then coral re-emerges into the hero as the ambient glow
               (butter follows), where Blob B used to be.
       2.4–2.9s the sticky header (hidden until now — see the is:global
               style block) slides down once the gradient has filled.
       2.2–3.0s the tagline fades in DEAD-CENTER on the settled gradient
               (vertically + horizontally, all viewports) at ~1.9× size —
               the brand speaks first — holds through ~4s…
       4.0–5.2s …then rises to its slot at the top of the centered copy
               block, shrinking into its docked eyebrow size,
       4.6–8.0s while headline → sub → form stagger in beneath it, an
               unhurried 0.7s apart.

     Ambient state (after the intro, runs indefinitely): two soft warm
     regions — coral in the top-right corner (Blob B's resting place) and
     butter in the bottom-right corner, deliberately far apart — drift and
     swell independently on offset loops but share one 4s breathing pulse
     on their parent: two independent motions, one shared rhythm, same as
     the babies the product tracks. Transform/opacity only; radial-gradient
     falloff, no blur filters, so it's compositor-cheap.

     BRAND NOTE: coral inside the hero gradient is a deliberate extension of
     the signature 3-stop, approved by Kayla (2026-07-06). The copy is
     CENTERED (Kayla's call, 2026-07-06), so the glows are pinned to the
     top-right/bottom-right corners with restrained sweep — white copy must
     never sit on meaningful coral/butter (their white-text contrast is too
     low; same corner rule the butter stop already follows).

     prefers-reduced-motion: no intro, no drift — straight to the static
     hero with the coral glow present but still. -->
<section class="hero" id="waitlist">
  <div class="hero__ambient" aria-hidden="true">
    <div class="hero__glow hero__glow--coral"></div>
    <div class="hero__glow hero__glow--butter"></div>
  </div>

  <div class="hero__intro" aria-hidden="true">
    <svg class="hero__intro-blobs" viewBox="0 0 640 520" fill="none" role="presentation">
      <defs>
        <!-- Signature gradient, transcribed from --gradient-signature (160deg) -->
        <linearGradient id="hero-intro-grad-a" x1="0.15" y1="0" x2="0.75" y2="1">
          <stop offset="0" stop-color="#3ea6c2"></stop>
          <stop offset="0.55" stop-color="#2f7d6b"></stop>
          <stop offset="1" stop-color="#ffcb57"></stop>
        </linearGradient>
        <!-- Sibling palette: Coral → Teal-green -->
        <linearGradient id="hero-intro-grad-b" x1="0.2" y1="0.05" x2="0.7" y2="1">
          <stop offset="0" stop-color="#ff7357"></stop>
          <stop offset="1" stop-color="#2f7d6b"></stop>
        </linearGradient>
      </defs>
      <!-- A first, B second: B stays on top while A takes over beneath it,
           so B visibly melts into the new background instead of being
           swallowed by it. -->
      <path
        class="hero__intro-blob hero__intro-blob--a"
        fill="url(#hero-intro-grad-a)"
        d="M394.9 250.8 C395.6 286.0 375.6 344.2 345.0 370.5 C314.5 396.8 245.1 406.8 211.5 408.6 C177.9 410.4 165.5 408.8 143.5 381.2 C121.5 353.6 85.5 285.5 79.7 243.0 C73.8 200.4 83.7 152.5 108.7 125.8 C133.6 99.0 190.7 76.9 229.4 82.5 C268.1 88.0 313.3 131.1 340.9 159.1 C368.5 187.2 394.2 215.5 394.9 250.8 Z"
      ></path>
      <path
        class="hero__intro-blob hero__intro-blob--b"
        fill="url(#hero-intro-grad-b)"
        d="M555.4 293.8 C555.6 323.0 556.8 355.8 538.9 376.8 C521.0 397.8 479.4 420.6 448.0 419.9 C416.5 419.2 371.0 390.3 350.1 372.6 C329.2 354.8 320.7 337.8 322.6 313.2 C324.5 288.7 341.8 248.4 361.6 225.4 C381.3 202.4 411.8 179.2 441.1 175.3 C470.4 171.3 518.3 182.0 537.4 201.8 C556.4 221.5 555.1 264.7 555.4 293.8 Z"
      ></path>
    </svg>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <!-- SITE.tagline, hardcoded here for the presentational line break —
           keep the words in sync with src/config.ts -->
      <p class="hero__eyebrow">You've got your hands full.<br />We've got you.</p>
      <h1 class="hero__title">The baby tracker built for twins, triplets&nbsp;&amp;&nbsp;more</h1>
      <p class="hero__sub">
        One tap logs a feed for everyone. One screen shows who ate, who slept, who's due.
        Finally — a tracker that starts where your family does.
      </p>
      <WaitlistCta variant="on-gradient" formId="waitlist-email-hero" source="hero" />
    </div>
  </div>
</section>

<script>
  // Measures how far the tagline's stage entrance (hero dead-center) is from
  // its laid-out slot, and hands the offset to the CSS animation via
  // --tagline-stage-y. Runs once at load: the stage moment is over within
  // seconds, so a mid-intro resize isn't worth handling. Suspend the
  // element's animations while measuring (they win over inline styles), and
  // note the reveal keeps the tagline invisible until 2.2s, so this can't
  // cause a flash.
  const hero = document.querySelector<HTMLElement>('.hero');
  const tagline = document.querySelector<HTMLElement>('.hero__eyebrow');
  if (hero && tagline && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    tagline.style.animation = 'none';
    tagline.style.transform = 'none';
    const heroBox = hero.getBoundingClientRect();
    const slotBox = tagline.getBoundingClientRect();
    tagline.style.animation = '';
    tagline.style.transform = '';
    const dy = heroBox.top + heroBox.height / 2 - (slotBox.top + slotBox.height / 2);
    tagline.style.setProperty('--tagline-stage-y', `${Math.round(dy)}px`);
  }
</script>

<style>
  .hero {
    position: relative;
    background: var(--gradient-signature);
    color: #fff;
    /* Also what clips Blob A as it scales past the edges */
    overflow: hidden;
  }
  .hero__inner {
    /* Above the ambient glows; the intro overlay (z-index 2) still wins */
    position: relative;
    padding-block: clamp(var(--space-16), 11vw, calc(var(--space-24) + var(--space-8)));
  }
  /* Centered hero copy (Kayla's call): every block centers itself, and the
     form (a child component) is centered via the :global margin rule. */
  .hero__copy {
    text-align: center;
  }
  .hero__copy > :global(*) {
    margin-inline: auto;
  }
  .hero__eyebrow {
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--butter);
    margin-bottom: var(--space-4);
  }
  .hero__title {
    color: #fff;
    max-width: 18ch;
  }
  .hero__sub {
    margin-block: var(--space-6);
    font-size: 19px;
    line-height: 28px;
    font-weight: 500;
    max-width: 46ch;
  }

  /* ---- Ambient warm regions (permanent) ------------------------------ */

  .hero__ambient {
    position: absolute;
    inset: 0;
    /* The shared rhythm: one breath for both glows… */
    animation: ambient-breathe 4s ease-in-out infinite;
  }
  .hero__glow {
    position: absolute;
    aspect-ratio: 1;
    will-change: transform;
  }
  /* …while each drifts to its own slow, offset cycle. Both hug the right
     edge, clear of the white copy (contrast rule — see brand note above). */
  .hero__glow--coral {
    width: clamp(420px, 48vw, 760px);
    top: -22%;
    right: -16%;
    background: radial-gradient(
      closest-side,
      rgba(255, 115, 87, 0.62),
      rgba(255, 115, 87, 0) 70%
    );
    animation:
      glow-appear 1.1s ease 2.1s both,
      drift-coral 9s ease-in-out -3s infinite alternate;
  }
  .hero__glow--butter {
    width: clamp(360px, 40vw, 640px);
    bottom: -30%;
    right: -8%;
    background: radial-gradient(
      closest-side,
      rgba(255, 203, 87, 0.52),
      rgba(255, 203, 87, 0) 70%
    );
    animation:
      glow-appear 1.1s ease 2.4s both,
      drift-butter 13s ease-in-out -8s infinite alternate;
  }

  @keyframes ambient-breathe {
    0%,
    100% {
      transform: scale(0.97);
    }
    50% {
      transform: scale(1.03);
    }
  }
  @keyframes glow-appear {
    from {
      opacity: 0;
    }
  }
  /* Both glows sweep toward the teal (where warm color actually contrasts)
     and swell as they move, so the motion reads at a glance — but the sweep
     is restrained now that the copy is centered: meaningful color must stay
     clear of the text column. Different periods + offsets keep their peaks
     from coinciding. */
  @keyframes drift-coral {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(-9%, 12%, 0) scale(1.2);
    }
  }
  @keyframes drift-butter {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(-8%, -8%, 0) scale(1.16);
    }
  }

  @media (max-width: 800px) {
    /* Narrow screens: copy spans the full width, so push the glows further
       off-canvas — coral stays visible at the edge, never behind text. */
    .hero__glow--coral {
      right: -35%;
    }
    .hero__glow--butter {
      right: -25%;
    }
  }

  /* ---- Intro overlay (one-time) --------------------------------------- */

  .hero__intro {
    /* Morph targets from scripts/generate-blobs.mjs — regenerate there,
       don't hand-edit (variants must keep one command structure to tween). */
    --blob-a-0: path('M394.9 250.8 C395.6 286.0 375.6 344.2 345.0 370.5 C314.5 396.8 245.1 406.8 211.5 408.6 C177.9 410.4 165.5 408.8 143.5 381.2 C121.5 353.6 85.5 285.5 79.7 243.0 C73.8 200.4 83.7 152.5 108.7 125.8 C133.6 99.0 190.7 76.9 229.4 82.5 C268.1 88.0 313.3 131.1 340.9 159.1 C368.5 187.2 394.2 215.5 394.9 250.8 Z');
    --blob-a-1: path('M379.6 230.4 C384.2 264.7 371.6 326.1 346.7 352.3 C321.8 378.5 268.8 386.4 230.2 387.7 C191.7 388.9 144.3 382.0 115.5 360.1 C86.8 338.2 55.6 297.3 57.9 256.1 C60.2 214.9 101.9 141.4 129.3 113.0 C156.7 84.6 190.7 80.0 222.4 85.5 C254.0 91.0 293.1 121.9 319.3 146.0 C345.5 170.2 375.0 196.0 379.6 230.4 Z');
    --blob-a-2: path('M418.6 268.6 C419.4 307.8 374.3 317.7 341.1 339.4 C308.0 361.1 257.0 395.2 219.7 399.0 C182.4 402.9 137.9 390.5 117.6 362.3 C97.3 334.1 95.8 272.2 97.9 230.0 C100.0 187.7 108.4 127.4 130.2 108.8 C152.0 90.1 194.3 118.7 228.6 118.0 C262.9 117.3 304.4 79.6 336.1 104.7 C367.7 129.8 417.7 229.5 418.6 268.6 Z');
    --blob-b-0: path('M555.4 293.8 C555.6 323.0 556.8 355.8 538.9 376.8 C521.0 397.8 479.4 420.6 448.0 419.9 C416.5 419.2 371.0 390.3 350.1 372.6 C329.2 354.8 320.7 337.8 322.6 313.2 C324.5 288.7 341.8 248.4 361.6 225.4 C381.3 202.4 411.8 179.2 441.1 175.3 C470.4 171.3 518.3 182.0 537.4 201.8 C556.4 221.5 555.1 264.7 555.4 293.8 Z');
    --blob-b-1: path('M562.3 302.3 C565.6 332.8 553.8 373.2 532.5 388.6 C511.3 404.1 465.8 395.5 434.6 395.1 C403.5 394.6 365.2 406.2 345.8 385.8 C326.3 365.4 312.1 302.1 317.9 272.6 C323.6 243.1 355.4 230.5 380.2 208.8 C405.0 187.1 444.5 142.9 466.6 142.4 C488.8 141.9 497.1 179.2 513.0 205.9 C529.0 232.5 559.1 271.9 562.3 302.3 Z');
    --blob-b-2: path('M557.3 281.5 C558.8 309.3 565.2 332.6 546.3 352.4 C527.3 372.2 473.8 394.8 443.5 400.2 C413.2 405.7 384.6 405.3 364.4 385.1 C344.2 365.0 324.0 306.5 322.3 279.2 C320.7 251.9 336.5 243.4 354.4 221.3 C372.4 199.2 399.6 152.7 430.1 146.8 C460.6 140.8 516.3 163.1 537.5 185.6 C558.7 208.0 555.9 253.7 557.3 281.5 Z');

    position: absolute;
    inset: 0;
    /* Above hero content until it fades; below the sticky header (40) and
       cookie banner (50). */
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    background: var(--warm-bg);
    pointer-events: none;
    animation: intro-vanish 0.6s ease 1.8s both;
  }

  .hero__intro-blobs {
    width: min(400px, 68%);
    height: auto;
    margin-top: clamp(32px, 10vh, 110px);
    /* Let the blobs grow past the small SVG canvas; .hero clips instead */
    overflow: visible;
  }

  .hero__intro-blob {
    transform-box: fill-box;
    transform-origin: center;
  }
  .hero__intro-blob--a {
    animation:
      intro-a-morph 2s ease-in-out both,
      intro-a-takeover 1.3s cubic-bezier(0.42, 0, 1, 1) 0.6s both;
    will-change: transform;
  }
  /* Blob B swells and fades to nothing while A takes over; after a beat of
     pure gradient, coral re-enters as .hero__glow--coral (2.1s). */
  .hero__intro-blob--b {
    animation:
      intro-b-morph 2s ease-in-out both,
      intro-b-dissolve 1s cubic-bezier(0.42, 0, 1, 1) 0.7s both;
    will-change: transform, opacity;
  }

  @keyframes intro-vanish {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
  @keyframes intro-a-takeover {
    to {
      transform: scale(15);
    }
  }
  @keyframes intro-b-dissolve {
    to {
      transform: scale(6);
      opacity: 0;
    }
  }
  @keyframes intro-a-morph {
    0% {
      d: var(--blob-a-0);
    }
    50% {
      d: var(--blob-a-1);
    }
    100% {
      d: var(--blob-a-2);
    }
  }
  @keyframes intro-b-morph {
    0% {
      d: var(--blob-b-0);
    }
    50% {
      d: var(--blob-b-1);
    }
    100% {
      d: var(--blob-b-2);
    }
  }

  /* ---- Content reveal (intro phase 3) ---------------------------------
     :global() because .hero__copy's children include the WaitlistCta form,
     which doesn't carry this component's scope attribute. */

  .hero__copy > :global(*) {
    animation: hero-reveal 1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero__copy > :global(*:nth-child(2)) {
    animation-delay: 4.6s;
  }
  .hero__copy > :global(*:nth-child(3)) {
    animation-delay: 5.3s;
  }
  .hero__copy > :global(*:nth-child(4)) {
    animation-delay: 6s;
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* Tagline: the brand speaks first. Enters title-sized at the hero's
     dead center — horizontal centering comes from the copy's text-align;
     vertical centering is a transform offset (--tagline-stage-y) measured
     once by the script below, since percentage `top` on relative elements
     resolves against the wrong box in Chromium. It holds a beat, then
     rises to its slot while shrinking into the eyebrow it becomes.
     Transform-only, so nothing reflows; without JS the stage-y stays 0 and
     the tagline simply plays its beat in its slot (still centered
     horizontally). This rule sits after the .hero__copy > * reveal rule so
     its animation list wins. */
  .hero__eyebrow {
    --tagline-stage-scale: 1.9;
    --tagline-stage-y: 0px;
    display: inline-block;
    transform: translateY(var(--tagline-stage-y)) scale(var(--tagline-stage-scale));
    animation:
      tagline-enter 0.8s cubic-bezier(0.22, 1, 0.36, 1) 2.2s both,
      tagline-dock 1.2s cubic-bezier(0.65, 0, 0.35, 1) 4s both;
  }
  @keyframes tagline-enter {
    from {
      opacity: 0;
      transform: translateY(calc(var(--tagline-stage-y) + 14px))
        scale(var(--tagline-stage-scale));
    }
    to {
      opacity: 1;
      transform: translateY(var(--tagline-stage-y)) scale(var(--tagline-stage-scale));
    }
  }
  @keyframes tagline-dock {
    from {
      transform: translateY(var(--tagline-stage-y)) scale(var(--tagline-stage-scale));
    }
    to {
      transform: translateY(0px) scale(1);
    }
  }
  @media (max-width: 800px) {
    /* The line break keeps each line short, but 1.9× is still too wide for
       a 390px viewport — 1.6× reads as a title without clipping. */
    .hero__eyebrow {
      --tagline-stage-scale: 1.6;
    }
  }

  /* Skip the intro and still the glows: straight to the finished hero.
     Needed explicitly — global.css only zeroes animation *durations*, which
     would leave the 2.45s+ reveal delays as seconds of invisible content. */
  @media (prefers-reduced-motion: reduce) {
    .hero__intro {
      display: none;
    }
    .hero__ambient,
    .hero__glow,
    .hero__copy > :global(*) {
      animation: none;
    }
    /* The tagline's resting styles are its centered stage position; with
       animations off it must be pinned to the docked state instead. */
    .hero__eyebrow {
      animation: none;
      transform: none;
    }
  }
</style>

<style is:global>
  /* Part of the hero intro, but reaching outside the component: the sticky
     header stays hidden while the blobs open, then slides down once the
     gradient has fully filled the hero (~2.4s, after the overlay crossfade
     completes). Global on purpose — Header.astro is rendered by the layout,
     but because this rule ships with Hero.astro it only exists on pages
     that have the hero (the landing page); the header appears instantly
     everywhere else. Delete alongside the intro. */
  .header {
    animation: header-reveal 0.5s cubic-bezier(0.22, 1, 0.36, 1) 2.4s both;
  }
  @keyframes header-reveal {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .header {
      animation: none;
    }
  }
</style>
