---
import StoreBadges from '../components/StoreBadges.astro';
import { TAGLINE_LINES, HEADLINE } from '../config';
---

<!-- Signature gradient hero with a living coral accent. Copy stays short
     per the "never behind long text" rule; headline is large-text white per
     the brand's accessible-pairings table. The app mock lives in the "See
     it in action" section below, so the hero stays uncrowded and the
     gradient + copy carry it.

     Intro (plays once per page load): the copy fades straight onto the
     gradient — no overlay, so the gradient and glows are there from the
     first frame. The tagline enters CENTER-STAGE at ~1.9× size, holds a
     beat, then DOCKS (scales down and rises into its slot — the payoff
     moment) while headline and form fade up beneath it. ~2.75s total —
     tuned between the original 5.9s (too slow) and the compressed 2.4s
     (too fast); every timing/scale knob lives in the custom properties on
     .hero__copy / .hero__eyebrow below.
       0.3–0.75s  tagline fades in dead-center at stage size,
       0.95–1.6s  …then docks into its slot,
       1.25–2.15s headline fades up (~50% through the dock; its delay is
                  the page's LCP anchor — keep ≤1.5s),
       1.7–2.75s  the App Store badge completes the stagger.
     The header and the sections below the hero are deliberately NOT
     animated or delayed: they paint immediately, whatever the copy fade is
     doing.

     Ambient state (runs indefinitely): a lava lamp. Five soft regions —
     coral top-right, a dimmer coral top-left, butter bottom-right and
     mid-left, and a faint sky bloom in the bottom-left corner — each
     wander a closed multi-waypoint path with asymmetric squish
     (scale(x, y) per waypoint, like a lava blob elongating as it floats),
     on different periods and offsets so the field never repeats visibly.
     All of them share one 4s breathing pulse on their parent: independent
     motions, one shared rhythm, same as the babies the product tracks.
     Transform/opacity only; radial-gradient falloff, no blur filters, so
     it's compositor-cheap.

     BRAND NOTE: coral inside the hero gradient is a deliberate extension of
     the signature 3-stop, approved by Kayla (2026-07-06). The copy is
     CENTERED (Kayla's call, 2026-07-06), so the glows are pinned to the
     edges/corners with restrained sweep toward the middle — white copy must
     never sit on meaningful coral/butter (their white-text contrast is too
     low; same corner rule the butter stop already follows). The gradient's
     top stop is deepened from the style guide's sky (#3ea6c2 → #2b7a90,
     a11y 2026-07-15) so the white tagline passes AA on it; the tagline
     itself went butter → white in the same fix.

     prefers-reduced-motion: no fade, no drift — straight to the static
     hero with the glows present but still. -->
<section class="hero" id="pre-order">
  <div class="hero__ambient" aria-hidden="true">
    <div class="hero__glow hero__glow--coral"></div>
    <div class="hero__glow hero__glow--coral2"></div>
    <div class="hero__glow hero__glow--butter"></div>
    <div class="hero__glow hero__glow--butter2"></div>
    <div class="hero__glow hero__glow--sky"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <!-- The tagline's sentences (src/copy.mjs) with a presentational line
           break between them; SITE.tagline is the same words on one line. -->
      <p class="hero__eyebrow">
        {TAGLINE_LINES.map((line, i) => (i > 0 ? <><br />{line}</> : line))}
      </p>
      <h1 class="hero__title">{HEADLINE}</h1>
      <!-- No subhead: the hero stays sparse (tagline + headline + CTA);
           the one-tap pitch lives in "See it in action" below. -->
      <!-- Primary CTA: the official Apple badge. Which badge, and the
           wording that goes with it, is one config value — see
           CTA.appleBadge / CTA_LABEL and StoreBadges.astro. -->
      <StoreBadges variant="on-gradient" />
    </div>
  </div>
</section>

<script>
  // Measures how far the tagline's stage entrance (hero dead-center) is from
  // its laid-out slot, and hands the offset to the CSS animation via
  // --tagline-stage-y. Runs once at load: the stage moment is over within
  // seconds, so a mid-sequence resize isn't worth handling. Suspend the
  // element's animations while measuring (they win over inline styles), and
  // note the reveal keeps the tagline invisible until its enter delay, so
  // this can't cause a flash.
  const hero = document.querySelector<HTMLElement>('.hero');
  const tagline = document.querySelector<HTMLElement>('.hero__eyebrow');
  if (hero && tagline && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    tagline.style.animation = 'none';
    tagline.style.transform = 'none';
    const heroBox = hero.getBoundingClientRect();
    const slotBox = tagline.getBoundingClientRect();
    tagline.style.animation = '';
    tagline.style.transform = '';
    const dy = heroBox.top + heroBox.height / 2 - (slotBox.top + slotBox.height / 2);
    tagline.style.setProperty('--tagline-stage-y', `${Math.round(dy)}px`);
  }
</script>

<style>
  .hero {
    position: relative;
    background: var(--gradient-signature);
    color: #fff;
    /* Clips the ambient glows sweeping past the edges */
    overflow: hidden;
  }
  .hero__inner {
    /* Above the ambient glows */
    position: relative;
    padding-block: clamp(var(--space-16), 11vw, calc(var(--space-24) + var(--space-8)));
  }
  /* Centered hero copy (Kayla's call): every block centers itself, and the
     form (a child component) is centered via the :global margin rule. */
  .hero__copy {
    text-align: center;
  }
  .hero__copy > :global(*) {
    margin-inline: auto;
  }
  .hero__eyebrow {
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    /* White, not butter: butter measured 1.87:1 on the gradient's sky
       region (15px bold isn't "large text" — needs 4.5:1). White passes
       AA everywhere it sits (see --gradient-signature). */
    color: #fff;
    margin-bottom: var(--space-4);
  }
  .hero__title {
    color: #fff;
    max-width: 18ch;
    margin-bottom: var(--space-8);
  }
  /* The badge row is a flex container, so text-align can't centre it; it
     also stays as wide as its content so margin-inline:auto lands it in
     the middle of the copy column. */
  .hero__copy > :global(.store-badges) {
    justify-content: center;
    width: fit-content;
  }

  /* ---- Ambient warm regions (permanent) ------------------------------ */

  .hero__ambient {
    position: absolute;
    inset: 0;
    /* The shared rhythm: one breath for both glows… */
    animation: ambient-breathe 4s ease-in-out infinite;
  }
  .hero__glow {
    position: absolute;
    aspect-ratio: 1;
    will-change: transform;
  }
  /* …while each drifts to its own slow, offset cycle. Both hug the right
     edge, clear of the white copy (contrast rule — see brand note above). */
  .hero__glow--coral {
    width: clamp(600px, 66vw, 1080px);
    /* Anchors are rescaled with the 1.45x size growth so each core keeps
       its previous absolute position — the extra size reads as wider, softer
       coverage around the same spot, not a repositioned glow. */
    top: -40%;
    right: -16%;
    background: radial-gradient(
      closest-side,
      rgba(255, 115, 87, 0.4) 0%,
      rgba(255, 115, 87, 0.2) 20%,
      rgba(255, 115, 87, 0.068) 40%,
      rgba(255, 115, 87, 0.014) 61%,
      rgba(255, 115, 87, 0.002) 73%,
      rgba(255, 115, 87, 0) 82%
    );
    animation:
      glow-appear 0.9s ease 0.2s both,
      drift-coral 8s ease-in-out -4s infinite;
  }
  /* Second coral, top-left: dimmer sibling of the main coral so the warm
     color frames both sides. Its sweep heads down-right into the teal but
     stays shy of the centered headline's left edge. */
  .hero__glow--coral2 {
    width: clamp(480px, 50vw, 860px);
    top: -30%;
    left: -14%;
    background: radial-gradient(
      closest-side,
      rgba(255, 115, 87, 0.27) 0%,
      rgba(255, 115, 87, 0.151) 20%,
      rgba(255, 115, 87, 0.068) 40%,
      rgba(255, 115, 87, 0.017) 61%,
      rgba(255, 115, 87, 0.003) 73%,
      rgba(255, 115, 87, 0) 82%
    );
    animation:
      glow-appear 0.9s ease 0.5s both,
      drift-coral2 9.5s ease-in-out -6s infinite;
  }
  .hero__glow--butter {
    width: clamp(520px, 56vw, 920px);
    /* The bottom-right butter bloom carries the corner warmth the original
       gradient had — a radial source keeps butter far from the centered
       disclaimer in both dimensions, which the linear ramp can't. Anchor +
       alpha are tuned against the disclaimer's measured worst drift phase. */
    bottom: -56%;
    right: -18%;
    background: radial-gradient(
      closest-side,
      rgba(255, 203, 87, 0.46) 0%,
      rgba(255, 203, 87, 0.212) 20%,
      rgba(255, 203, 87, 0.055) 40%,
      rgba(255, 203, 87, 0.008) 61%,
      rgba(255, 203, 87, 0.001) 73%,
      rgba(255, 203, 87, 0) 82%
    );
    animation:
      glow-appear 0.9s ease 0.35s both,
      drift-butter 11s ease-in-out -10s infinite;
  }
  /* Second butter, mid-left: warms the left edge (coral + butter otherwise
     concentrate on the right) — teal-green would vanish against the
     gradient's own teal mid-band, so butter carries the balance. Dimmer
     than the bottom-right butter, and mostly off-canvas: only its faint
     outer falloff approaches the centered copy. */
  .hero__glow--butter2 {
    width: clamp(460px, 48vw, 800px);
    top: 16%;
    left: -16%;
    background: radial-gradient(
      closest-side,
      rgba(255, 203, 87, 0.25) 0%,
      rgba(255, 203, 87, 0.14) 20%,
      rgba(255, 203, 87, 0.062) 40%,
      rgba(255, 203, 87, 0.016) 61%,
      rgba(255, 203, 87, 0.003) 73%,
      rgba(255, 203, 87, 0) 82%
    );
    animation:
      glow-appear 0.9s ease 0.8s both,
      drift-butter2 10.5s ease-in-out -3s infinite;
  }
  /* Faint cool bloom, pinned to the bottom-left corner: its meaningful
     color must stay below/left of the centered form (white small text over
     a sky-lightened teal would drop under AA). */
  .hero__glow--sky {
    width: clamp(480px, 53vw, 860px);
    bottom: -47%;
    left: -14%;
    background: radial-gradient(
      closest-side,
      rgba(62, 166, 194, 0.29) 0%,
      rgba(62, 166, 194, 0.162) 20%,
      rgba(62, 166, 194, 0.072) 40%,
      rgba(62, 166, 194, 0.018) 61%,
      rgba(62, 166, 194, 0.003) 73%,
      rgba(62, 166, 194, 0) 82%
    );
    animation:
      glow-appear 0.9s ease 0.65s both,
      drift-sky 13s ease-in-out -7s infinite;
  }

  @keyframes ambient-breathe {
    0%,
    100% {
      transform: scale(0.97);
    }
    50% {
      transform: scale(1.03);
    }
  }
  @keyframes glow-appear {
    from {
      opacity: 0;
    }
  }
  /* Lava-lamp wander: closed multi-waypoint loops (not a two-point
     alternate, which reads as a metronome) with asymmetric scale(x, y)
     squish so each blob elongates and settles as it floats. Travel and
     tempo are deliberately assertive (~1.3× the previous sweep on faster
     8–13s loops) so the drift reads at a glance instead of demanding a
     stare — but sweeps toward the teal stay capped: meaningful color must
     remain clear of the centered text column (the eased quadratic falloff
     — stops chosen so it fades to 0 with no slope kink, i.e. no visible
     rim over the flat plateau — is near-zero past ~50%
     radius, so only the faint outer half approaches it). The inward
     (toward-center) legs grew the least; the vertical and outward legs
     carry most of the extra travel. Different periods + offsets keep the
     five from ever aligning. */
  @keyframes drift-coral {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1, 1);
    }
    30% {
      transform: translate3d(-14%, 19%, 0) scale(1.24, 0.87);
    }
    60% {
      transform: translate3d(-19%, 6%, 0) scale(1.38, 1.14);
    }
    80% {
      transform: translate3d(-7%, -14%, 0) scale(0.92, 1.3);
    }
  }
  @keyframes drift-coral2 {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1, 1);
    }
    35% {
      transform: translate3d(12%, 16%, 0) scale(1.27, 0.89);
    }
    65% {
      transform: translate3d(17%, 3%, 0) scale(1.08, 1.36);
    }
    85% {
      transform: translate3d(6%, -12%, 0) scale(1.33, 0.93);
    }
  }
  @keyframes drift-butter {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1, 1);
    }
    25% {
      transform: translate3d(-16%, -14%, 0) scale(1.3, 0.83);
    }
    55% {
      transform: translate3d(-7%, -26%, 0) scale(1, 1.38);
    }
    75% {
      transform: translate3d(12%, -10%, 0) scale(1.34, 1.05);
    }
  }
  @keyframes drift-butter2 {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1, 1);
    }
    30% {
      transform: translate3d(10%, 13%, 0) scale(1.24, 0.9);
    }
    60% {
      transform: translate3d(15%, -6%, 0) scale(1.05, 1.32);
    }
    80% {
      transform: translate3d(3%, -15%, 0) scale(1.3, 0.94);
    }
  }
  @keyframes drift-sky {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1, 1);
    }
    40% {
      transform: translate3d(13%, -19%, 0) scale(1.36, 0.92);
    }
    70% {
      transform: translate3d(20%, -6%, 0) scale(0.88, 1.38);
    }
  }

  @media (max-width: 800px) {
    /* Phones: the hero owns the visible screen (svh ignores the URL-bar
       dance) with the copy vertically centered — otherwise the content
       hugs the top and the tagline's center-stage moment can land under
       browser chrome / the cookie banner on short viewports. */
    .hero__inner {
      min-height: calc(100vh - 80px); /* fallback; 80px ≈ sticky header */
      min-height: calc(100svh - 80px);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    /* Small viewports can't host the desktop-scale glows (their min clamps
       exceed the viewport width) — cap the sizes. And since the copy spans
       nearly the full width here, the glows sit ABOVE and BELOW the
       vertically-centered copy band instead of being shoved off the sides:
       visible orbs in the corners, clear of the text. */
    .hero__glow--coral {
      width: 460px;
      top: -21%;
      right: -30%;
    }
    .hero__glow--coral2 {
      width: 380px;
      top: -23%;
      left: -32%;
    }
    .hero__glow--butter {
      width: 440px;
      bottom: -32%;
      right: -28%;
    }
    /* butter2 stays hidden on phones: its mid-left slot is text-adjacent
       at this width — the other four carry the corners. */
    .hero__glow--butter2 {
      display: none;
    }
    .hero__glow--sky {
      width: 400px;
      bottom: -28%;
      left: -32%;
    }
  }

  /* ---- Copy reveal (one-time) -------------------------------------------
     Tagline center-stage → dock → headline/form stagger, ~2.75s total.
     EVERY timing knob lives in the custom properties below — tune here, the
     rules only reference them. :global() because .hero__copy's children
     include the StoreBadges markup, which doesn't carry this component's
     scope attribute. */

  .hero__copy {
    --tagline-enter-at: 0.3s; /* fades in dead-center at stage size… */
    --tagline-enter-dur: 0.45s;
    --tagline-dock-at: 0.95s; /* …holds a beat, then docks into its slot */
    --tagline-dock-dur: 0.65s;
    --headline-at: 1.25s; /* ~50% through the dock; the LCP floor — ≤1.5s */
    --headline-dur: 0.9s;
    --cta-at: 1.7s;
    --cta-dur: 1.05s; /* settles at ~2.75s — keep the banner's
                         SHOW_DELAY_MS (CookieConsentBanner) in sync */
  }

  .hero__copy > :global(*) {
    animation: hero-reveal 1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero__copy > :global(*:nth-child(2)) {
    animation-delay: var(--headline-at);
    animation-duration: var(--headline-dur);
  }
  .hero__copy > :global(*:nth-child(3)) {
    animation-delay: var(--cta-at);
    animation-duration: var(--cta-dur);
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* Tagline: the brand speaks first. Enters title-sized at the hero's
     dead center — horizontal centering comes from the copy's text-align;
     vertical centering is a transform offset (--tagline-stage-y) measured
     once by the script above, since percentage `top` on relative elements
     resolves against the wrong box in Chromium. It holds a beat, then
     rises to its slot while shrinking into the eyebrow it becomes.
     Transform-only, so nothing reflows; without JS the stage-y stays 0 and
     the tagline simply plays its beat in its slot (still centered
     horizontally). This rule sits after the .hero__copy > * reveal rule so
     its animation list wins. */
  .hero__eyebrow {
    --tagline-stage-scale: 1.9;
    --tagline-stage-y: 0px;
    display: inline-block;
    transform: translateY(var(--tagline-stage-y)) scale(var(--tagline-stage-scale));
    animation:
      tagline-enter var(--tagline-enter-dur) cubic-bezier(0.22, 1, 0.36, 1)
        var(--tagline-enter-at) both,
      tagline-dock var(--tagline-dock-dur) cubic-bezier(0.65, 0, 0.35, 1)
        var(--tagline-dock-at) both;
  }
  @keyframes tagline-enter {
    from {
      opacity: 0;
      transform: translateY(calc(var(--tagline-stage-y) + 14px))
        scale(var(--tagline-stage-scale));
    }
    to {
      opacity: 1;
      transform: translateY(var(--tagline-stage-y)) scale(var(--tagline-stage-scale));
    }
  }
  @keyframes tagline-dock {
    from {
      transform: translateY(var(--tagline-stage-y)) scale(var(--tagline-stage-scale));
    }
    to {
      transform: translateY(0px) scale(1);
    }
  }
  @media (max-width: 800px) {
    /* The line break keeps each line short, but 1.9× is still too wide for
       a 390px viewport — 1.4× reads as a title while keeping ~30px of
       breathing room to each edge. */
    .hero__eyebrow {
      --tagline-stage-scale: 1.4;
    }
  }

  /* Skip the reveal and still the glows: straight to the finished hero.
     Needed explicitly — global.css only zeroes animation *durations*, which
     would leave the reveal delays as seconds of invisible content. */
  @media (prefers-reduced-motion: reduce) {
    .hero__ambient,
    .hero__glow,
    .hero__copy > :global(*) {
      animation: none;
    }
    /* The tagline's resting styles are its centered stage position; with
       animations off it must be pinned to the docked state instead. */
    .hero__eyebrow {
      animation: none;
      transform: none;
    }
  }
</style>
