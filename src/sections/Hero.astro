---
import WaitlistCta from '../components/WaitlistCta.astro';
import TwinBlobs from '../components/TwinBlobs.astro';
import { SITE } from '../config';
---

<!-- Warm background + Ink text per the style guide; the Twin Blobs animation
     (two independent shapes, one shared breathing pulse) is the dominant
     visual — a wordless nod to multi-baby tracking. The app mock that used
     to live here moved to the "See it in action" section below. -->
<section class="hero" id="waitlist">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow">{SITE.tagline}</p>
      <h1 class="hero__title">The baby tracker built for twins, triplets&nbsp;&amp;&nbsp;more</h1>
      <p class="hero__sub">
        One tap logs a feed for everyone. One screen shows who ate, who slept, who's due.
        Finally — a tracker that starts where your family does.
      </p>
      <WaitlistCta variant="on-solid" formId="waitlist-email-hero" source="hero" />
    </div>
    <div class="hero__art">
      <TwinBlobs />
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--warm-bg);
    color: var(--ink);
    overflow: hidden;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-8);
    padding-block: clamp(var(--space-12), 9vw, var(--space-24));
  }
  .hero__eyebrow {
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: var(--space-4);
  }
  .hero__title {
    color: var(--ink);
    max-width: 15ch;
  }
  .hero__sub {
    margin-block: var(--space-6);
    color: var(--taupe-dark);
    font-size: 19px;
    line-height: 28px;
    font-weight: 500;
    max-width: 46ch;
  }
  .hero__art {
    display: flex;
    justify-content: center;
  }
  @media (max-width: 800px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    /* Copy + form stay first on mobile so the CTA is reachable fast;
       the blobs follow below. */
    .hero__art {
      margin-top: var(--space-4);
    }
  }
</style>
