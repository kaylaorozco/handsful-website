---
/**
 * "See it in action" — home of the stylized app mocks since the blob intro
 * took over as the hero visual. Flow: the hero hooks attention with motion
 * and a sparse pitch; this section delivers the proof right after — the
 * one-tap logging view (lede text was the old hero subhead) and the AI
 * pediatrician-ready visit summary, the app's two standout features.
 */
import AppPeek from '../components/AppPeek.astro';
import NotesPeek from '../components/NotesPeek.astro';
---

<section class="action section">
  <div class="container--narrow action__intro">
    <h2>See it in action</h2>
    <p class="action__lede">
      One tap logs a feed for everyone. One screen shows who ate, who slept, who's due.
      Finally — a tracker that starts where your family does.
    </p>
  </div>
  <div class="container action__peeks">
    <AppPeek />
    <NotesPeek />
  </div>
</section>

<style>
  /* White, so the warm-bg mock card reads against it (hero and Problem
     around this section are both warm-bg). */
  .action {
    background: #fff;
  }
  .action__intro {
    text-align: center;
  }
  .action__intro h2 {
    color: var(--teal);
  }
  .action__lede {
    margin-top: var(--space-4);
    color: var(--taupe);
    font-size: 19px;
    line-height: 28px;
  }
  .action__peeks {
    margin-top: var(--space-12);
    display: flex;
    flex-wrap: wrap; /* cards sit side by side, stacking on narrow screens */
    justify-content: center;
    /* Stretch so both figures (and via flex-grow, both cards) match the
       taller one's height — the two mocks should read as equals. */
    align-items: stretch;
    gap: var(--space-8);
  }
</style>
