---
/**
 * Shared layout for legal pages. While `placeholder` is true the page shows a
 * prominent pending-copy notice. Legal pages stay noindex'd (and excluded from
 * the sitemap — see astro.config.mjs) even after final copy lands: indexing
 * ships as a separate ticket. When final legal copy lands:
 *   1. Replace the page content.
 *   2. Set placeholder={false} and noindex={true} on that page.
 *   3. Leave the sitemap filter alone until the indexing ticket.
 */
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../config';

interface Props {
  title: string;
  description: string;
  placeholder?: boolean;
  /** Decoupled from `placeholder` — final-copy pages remain noindex'd until the indexing ticket. */
  noindex?: boolean;
  lastUpdated?: string;
}

const { title, description, placeholder = true, noindex = placeholder, lastUpdated } = Astro.props;
---

<BaseLayout title={`${title} — ${SITE.name}`} description={description} noindex={noindex}>
  <article class="legal section">
    <div class="container--narrow">
      <nav class="legal__breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-current="page">{title}</li>
        </ol>
      </nav>
      <h1>{title}</h1>
      {lastUpdated && <p class="legal__updated">Last updated: {lastUpdated}</p>}

      {
        placeholder && (
          <div class="legal__placeholder" role="note">
            <strong>Placeholder — final legal copy pending.</strong>
            <p>
              This page is a structural placeholder. The final {title} will be published here
              before Handsful launches. Questions in the meantime? Email{' '}
              <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.
            </p>
          </div>
        )
      }

      <div class="legal__body">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .legal__breadcrumb {
    margin-bottom: var(--space-6);
    font-size: 14px;
    line-height: 20px;
  }
  .legal__breadcrumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    color: var(--taupe);
  }
  .legal__breadcrumb li + li::before {
    content: '›';
    margin-right: var(--space-2);
  }
  .legal__updated {
    margin-top: var(--space-3);
    color: var(--taupe);
    font-size: 15px;
  }
  .legal__placeholder {
    margin-top: var(--space-8);
    padding: var(--space-6);
    background: #fff7e8;
    border: 2px solid var(--butter);
    border-radius: var(--radius-md);
  }
  .legal__placeholder p {
    margin-top: var(--space-2);
    font-size: 15px;
    line-height: 22px;
    color: var(--taupe-dark);
  }
  .legal__body {
    margin-top: var(--space-8);
  }
  .legal__body :global(h2) {
    margin-top: var(--space-8);
    font-size: 24px;
    line-height: 30px;
    /* TOC anchor targets must clear the sticky header (48px logo + padding). */
    scroll-margin-top: 96px;
  }
  /* Global h3 (26px) would outrank this layout's 24px h2 inside legal copy. */
  .legal__body :global(h3) {
    margin-top: var(--space-6);
    font-size: 20px;
    line-height: 26px;
  }
  .legal__body :global(p),
  .legal__body :global(li) {
    margin-top: var(--space-3);
    color: var(--taupe-dark);
  }
  .legal__body :global(.toc) {
    margin: var(--space-4) 0 0;
    padding-left: var(--space-6);
  }
  .legal__body :global(.toc li) {
    margin-top: var(--space-2);
  }
  .legal__body :global(ul) {
    margin: var(--space-3) 0 0;
    padding-left: var(--space-6);
  }
  /* Data tables (cookie/privacy policies) scroll inside their own wrapper on
     phones instead of pushing the page sideways. */
  .legal__body :global(.table-scroll) {
    margin-top: var(--space-4);
    overflow-x: auto;
  }
  .legal__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 22px;
  }
  .legal__body :global(th),
  .legal__body :global(td) {
    padding: var(--space-3) var(--space-4);
    border: 1px solid rgba(110, 100, 89, 0.3); /* --taupe at 30% */
    text-align: left;
    vertical-align: top;
    color: var(--taupe-dark);
  }
  .legal__body :global(th) {
    background: rgba(110, 100, 89, 0.08);
    color: var(--ink);
    font-weight: 700;
  }
  /* Legal copy cites URLs in full (e.g. the app-store refund policies in the
     Terms). Some are a single token longer than a phone viewport, which would
     push the whole page sideways — let them wrap mid-URL instead. */
  .legal__body :global(a) {
    overflow-wrap: break-word;
  }
</style>
