---
import '../styles/global.css';
import { SITE } from '../config';
import { CONSENT_KEY, CONSENT_TTL_MS } from '../consent';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import CookieConsentBanner from '../components/CookieConsentBanner.astro';

interface Props {
  /** Page <title>. Defaults to the site-wide SEO title. */
  title?: string;
  /** Meta description. Defaults to the site-wide one. */
  description?: string;
  /** Set on placeholder pages (legal) so search engines skip them until final. */
  noindex?: boolean;
  /** JSON-LD objects to emit for this page. */
  structuredData?: object[];
}

const {
  title = SITE.title,
  description = SITE.description,
  noindex = false,
  structuredData = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(SITE.ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#3EA6C2" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {
      structuredData.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }

    <!-- Consent bootstrap: read the stored cookie-consent choice BEFORE
         <Analytics /> runs, so its Consent Mode snippet can apply the choice
         between the denied default and gtag.js loading. The banner UI itself
         (CookieConsentBanner, end of <body>) writes this key on Accept/Decline. -->
    <script is:inline define:vars={{ CONSENT_KEY, CONSENT_TTL_MS }}>
      /* Key and TTL come from src/consent.ts via define:vars; this must run
         pre-gtag so it can't import the module — mirror parseStoredConsent
         exactly. Expired, invalid, or missing → null, i.e. Consent Mode's
         denied default stands. */
      try {
        var handsfulConsent = JSON.parse(localStorage.getItem(CONSENT_KEY));
        window.__handsfulStoredConsent =
          handsfulConsent &&
          (handsfulConsent.value === 'granted' || handsfulConsent.value === 'denied') &&
          Date.now() - Date.parse(handsfulConsent.timestamp) <= CONSENT_TTL_MS
            ? handsfulConsent.value
            : null;
      } catch (e) {
        window.__handsfulStoredConsent = null;
      }
    </script>
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieConsentBanner />
    <script>
      // The header and footer wordmarks scroll the current page back to the
      // top on every page (never a navigation/reload — their href="/" is
      // only the no-JS fallback). Lives here because both components render
      // from this layout.
      document.querySelectorAll<HTMLAnchorElement>('[data-scroll-top]').forEach((el) =>
        el.addEventListener('click', (event) => {
          event.preventDefault();
          const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
        }),
      );
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -100px;
    z-index: var(--z-skip-link);
    background: var(--ink);
    color: #fff;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    font-weight: 700;
    text-decoration: none;
    transition: top 120ms ease;
  }
  .skip-link:focus {
    top: var(--space-4);
  }
</style>
