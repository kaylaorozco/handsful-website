---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import SeeItInAction from '../sections/SeeItInAction.astro';
import ProblemSolution from '../sections/ProblemSolution.astro';
import FounderStory from '../sections/FounderStory.astro';
import SocialProof from '../sections/SocialProof.astro';
import Faq from '../sections/Faq.astro';
import FinalCta from '../sections/FinalCta.astro';
import { SITE, CTA } from '../config';
import { FAQ_ITEMS } from '../data/faq';

// --- Structured data ---------------------------------------------------
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/apple-touch-icon.png`,
  email: SITE.contactEmail,
  slogan: SITE.tagline,
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  applicationCategory: 'LifestyleApplication',
  // iOS-first launch — add ', Android' here when the Play release lands.
  operatingSystem: 'iOS',
  description: SITE.description,
  url: SITE.url,
  installUrl: CTA.appStoreUrl,
  // TODO(launch): add an `offers` block (price, priceCurrency) now that the
  // app is live, and an `aggregateRating` once there are real reviews to
  // quote. Both must match the App Store listing exactly — Google drops
  // structured data that contradicts the destination page.
  releaseNotes: 'Now available on the App Store.',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ_ITEMS.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout structuredData={[organizationSchema, appSchema, faqSchema]}>
  <Hero />
  <SeeItInAction />
  <ProblemSolution />
  <FounderStory />
  <SocialProof />
  <Faq />
  <FinalCta />
</BaseLayout>
