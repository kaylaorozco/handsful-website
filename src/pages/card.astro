---
/**
 * /card — the permanent URL behind the QR code printed on the business cards.
 *
 * The QR code encodes https://handsful.app/card and never changes. Where a
 * scan ends up is decided here, from `CARD` in src/config.ts:
 *   iPhone / iPad  → CARD.iosUrl
 *   Android        → CARD.androidUrl
 *   anything else  → no redirect; this page, with both store badges
 *
 * The current campaign promotes the app's existing 14-day free trial, so the
 * destinations are the normal store listings. A later campaign changes the
 * destinations and copy in `CARD` (or this page) — never the printed QR.
 *
 * The HTML as served IS the desktop page, so it works with no JavaScript at
 * all. On a phone the script below swaps it for "Opening Handsful…" and
 * redirects, leaving a button behind in case the browser doesn't follow.
 *
 * A QR stop, not a landing page: noindex'd, excluded from the sitemap (see
 * astro.config.mjs), and rendered without the site header and footer.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreBadges from '../components/StoreBadges.astro';
import Wordmark from '../components/Wordmark.astro';
import { CARD, SITE } from '../config';
import { CONSENT_GRANTED_EVENT } from '../consent';
---

<BaseLayout
  title={`Try ${SITE.name} free for 14 days`}
  description="Try Handsful, the baby tracker built for twins, triplets & more, free for 14 days. Download it on the App Store or Google Play."
  noindex={true}
  bare={true}
>
  <section
    class="card"
    data-card
    data-ios-url={CARD.iosUrl}
    data-android-url={CARD.androidUrl}
    data-consent-event={CONSENT_GRANTED_EVENT}
  >
    <div class="container--narrow card__inner">
      <a href="/" class="card__logo" aria-label="Handsful home">
        <Wordmark />
      </a>

      <div class="card__view" data-card-chooser>
        <h1>{CARD.headline}</h1>
        <p class="card__lead">{CARD.lead}</p>
        <StoreBadges appStoreUrl={CARD.iosUrl} playStoreUrl={CARD.androidUrl} />
        <p class="card__note">{CARD.note}</p>
      </div>

      <div class="card__view" data-card-opening hidden>
        <h1>Opening Handsful…</h1>
        <a class="btn btn--primary" href="/" data-card-fallback>
          Tap here if you’re not redirected
        </a>
      </div>

      <a href="/" class="card__home">Visit handsful.app</a>
    </div>
  </section>
</BaseLayout>

<script>
  // No imports, on purpose: a self-contained script this small is inlined
  // into the page by Astro (and hashed into the CSP), so a phone starts
  // redirecting without waiting on a second request. Values it needs from
  // the rest of the site arrive as data attributes on [data-card].
  type Platform = 'ios' | 'android' | 'desktop';

  /** Set just before the automatic redirect, so coming back to this page in
      the same tab (Back button, reload) shows the badges instead of bouncing
      the visitor straight out again. */
  const REDIRECTED_KEY = 'handsful_card_redirected';
  /** Longest the redirect waits for GA to confirm its events. Only applies to
      visitors who have already accepted analytics; everyone else goes at once. */
  const ANALYTICS_WAIT_MS = 700;

  function detectPlatform(): Platform {
    const ua = navigator.userAgent;
    if (/android/i.test(ua)) return 'android';
    if (/iPhone|iPad|iPod/.test(ua)) return 'ios';
    // iPadOS Safari calls itself a Mac; a touchscreen gives it away.
    if (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1) return 'ios';
    return 'desktop';
  }

  /** The scan's UTM parameters (handsful.app/card?utm_source=…), with the
      business-card defaults filled in for a bare /card. */
  function campaignParams(): URLSearchParams {
    const utm = new URLSearchParams();
    new URLSearchParams(location.search).forEach((value, key) => {
      if (key.startsWith('utm_')) utm.set(key, value);
    });
    if (!utm.has('utm_source')) utm.set('utm_source', 'business_card');
    if (!utm.has('utm_medium')) utm.set('utm_medium', 'qr');
    return utm;
  }

  /** Play listing URLs take the campaign as `referrer`, which Play Console
      reports under acquisition. Every other destination is left untouched —
      a campaign link carries its own parameters. */
  function withCampaign(url: string): string {
    try {
      const parsed = new URL(url);
      if (
        parsed.hostname === 'play.google.com' &&
        parsed.pathname === '/store/apps/details' &&
        !parsed.searchParams.has('referrer')
      ) {
        parsed.searchParams.set('referrer', campaignParams().toString());
        return parsed.toString();
      }
    } catch {
      /* not a parsable URL — use it as written */
    }
    return url;
  }

  // GA only exists once the visitor has accepted analytics (see
  // Analytics.astro). Events raised before that wait here and are sent if
  // they accept on this page; otherwise they are never sent.
  const queued: Array<() => void> = [];
  function track(name: string, params: Record<string, string>, done?: () => void) {
    const send = () =>
      window.gtag?.('event', name, {
        source: 'business_card',
        ...params,
        transport_type: 'beacon',
        ...(done ? { event_callback: done } : {}),
      });
    if (window.gtag) send();
    else queued.push(send);
  }

  const root = document.querySelector<HTMLElement>('[data-card]');
  if (root) {
    document.addEventListener(root.dataset.consentEvent ?? '', () =>
      // Deferred so the GA loader's own listener has defined gtag first.
      setTimeout(() => queued.splice(0).forEach((send) => send())),
    );

    const platform = detectPlatform();
    const destinations = {
      ios: withCampaign(root.dataset.iosUrl ?? ''),
      android: withCampaign(root.dataset.androidUrl ?? ''),
    };

    root.querySelectorAll<HTMLAnchorElement>('a[data-store]').forEach((link) => {
      const store = link.dataset.store as 'ios' | 'android';
      link.href = destinations[store] || link.href;
      link.addEventListener('click', () =>
        track('business_card_store_click', { platform, store, destination: link.href }),
      );
    });

    const destination = platform === 'desktop' ? '' : destinations[platform];

    let alreadyRedirected = false;
    let canRemember = true;
    try {
      alreadyRedirected = sessionStorage.getItem(REDIRECTED_KEY) === '1';
    } catch {
      canRemember = false;
    }

    if (!destination || alreadyRedirected) {
      // Desktop, an unset destination, or a return visit: the page as served.
      if (!alreadyRedirected) {
        track('business_card_visit', { platform });
        track('business_card_desktop', { platform });
      }
    } else {
      const chooser = root.querySelector<HTMLElement>('[data-card-chooser]');
      const opening = root.querySelector<HTMLElement>('[data-card-opening]');
      const fallback = root.querySelector<HTMLAnchorElement>('[data-card-fallback]');
      if (fallback) {
        fallback.href = destination;
        fallback.addEventListener('click', () =>
          track('business_card_store_click', { platform, store: platform, destination }),
        );
      }
      if (chooser && opening) {
        chooser.hidden = true;
        opening.hidden = false;
      }

      let gone = false;
      const go = () => {
        if (gone) return;
        gone = true;
        try {
          sessionStorage.setItem(REDIRECTED_KEY, '1');
        } catch {
          canRemember = false;
        }
        // Without storage there is nothing to stop a Back press redirecting
        // again, so keep this page out of history instead.
        if (canRemember) location.assign(destination);
        else location.replace(destination);
      };

      if (window.gtag) {
        track('business_card_visit', { platform });
        track(`business_card_${platform}`, { platform, destination }, go);
        setTimeout(go, ANALYTICS_WAIT_MS);
      } else {
        go();
      }

      // Restored from the back/forward cache: scripts don't re-run, so swap
      // "Opening…" for the badges here.
      window.addEventListener('pageshow', (event) => {
        if (event.persisted && chooser && opening) {
          opening.hidden = true;
          chooser.hidden = false;
        }
      });
    }
  }
</script>

<style>
  .card {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding-block: var(--space-12);
    text-align: center;
  }
  .card__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
  }
  .card__logo {
    color: var(--ink);
  }
  .card__logo :global(.wordmark) {
    height: 48px;
  }
  .card__view:not([hidden]) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }
  .card__lead {
    max-width: 440px;
    color: var(--taupe-dark);
    font-size: 18px;
    line-height: 28px;
  }
  .card__view :global(.store-badges) {
    justify-content: center;
    margin-top: var(--space-2);
  }
  .card__note {
    color: var(--taupe-dark);
    font-size: 15px;
    line-height: 24px;
  }
  .card__home {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.01em;
  }
</style>
