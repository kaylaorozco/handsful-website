---
/**
 * /card — the permanent URL behind the QR code printed on the business cards.
 *
 * The QR code encodes https://handsful.app/card and never changes. This page
 * is the campaign landing page for everyone who scans it, on every device:
 * the campaign's message, then both store badges. Nobody is redirected — the
 * visitor reads the offer and chooses a store.
 *
 * The current campaign promotes the app's existing 14-day free trial, so the
 * badges link to the normal store listings. A later campaign changes the copy
 * and destinations in `CARD` (src/config.ts), or this page — never the
 * printed QR.
 *
 * The HTML as served is the whole page and works with no JavaScript at all.
 * The scripts only add emphasis (the visitor's own store first) and
 * analytics.
 *
 * Kept apart from the rest of the site: noindex'd, excluded from the sitemap
 * (see astro.config.mjs), and rendered without the site header and footer.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreBadges from '../components/StoreBadges.astro';
import Wordmark from '../components/Wordmark.astro';
import { CARD, SITE } from '../config';
import { CARD_PLATFORM_SRC } from '../card-platform';
import { CONSENT_GRANTED_EVENT } from '../consent';
---

<BaseLayout
  title={`Try ${SITE.name} free for 14 days`}
  description="Try Handsful, the baby tracker built for twins, triplets & more, free for 14 days. Download it on the App Store or Google Play."
  noindex={true}
  bare={true}
>
  <section class="card" data-card data-consent-event={CONSENT_GRANTED_EVENT}>
    <!-- Sets data-platform on this section before the content below is laid
         out. Rendered verbatim from CARD_PLATFORM_SRC, which astro.config.mjs
         hashes into the CSP — so it must not be transformed here. -->
    <script is:inline set:html={CARD_PLATFORM_SRC} />
    <div class="container--narrow card__inner">
      <a href="/" class="card__logo" aria-label="Handsful home">
        <Wordmark />
      </a>

      <div class="card__view">
        <h1>{CARD.headline}</h1>
        <p class="card__lead">{CARD.lead}</p>
        <StoreBadges appStoreUrl={CARD.iosUrl} playStoreUrl={CARD.androidUrl} />
        <p class="card__note">{CARD.note}</p>
      </div>

      <a href="/" class="card__home">Visit handsful.app</a>
    </div>
  </section>
</BaseLayout>

<script>
  // No imports, on purpose: a self-contained script this small is inlined
  // into the page by Astro (and hashed into the CSP), so it runs without
  // waiting on a second request. Values it needs from the rest of the site
  // arrive as data attributes on [data-card].
  type Platform = 'ios' | 'android' | 'desktop';

  /** The scan's UTM parameters (handsful.app/card?utm_source=…), with the
      business-card defaults filled in for a bare /card. */
  function campaignParams(): URLSearchParams {
    const utm = new URLSearchParams();
    new URLSearchParams(location.search).forEach((value, key) => {
      if (key.startsWith('utm_')) utm.set(key, value);
    });
    if (!utm.has('utm_source')) utm.set('utm_source', 'business_card');
    if (!utm.has('utm_medium')) utm.set('utm_medium', 'qr');
    return utm;
  }

  /** Play listing URLs take the campaign as `referrer`, which Play Console
      reports under acquisition. Every other destination is left untouched —
      a campaign link carries its own parameters. */
  function withCampaign(url: string): string {
    try {
      const parsed = new URL(url);
      if (
        parsed.hostname === 'play.google.com' &&
        parsed.pathname === '/store/apps/details' &&
        !parsed.searchParams.has('referrer')
      ) {
        parsed.searchParams.set('referrer', campaignParams().toString());
        return parsed.toString();
      }
    } catch {
      /* not a parsable URL — use it as written */
    }
    return url;
  }

  // GA only exists once the visitor has accepted analytics (see
  // Analytics.astro). Events raised before that wait here and are sent if
  // they accept on this page; otherwise they are never sent.
  const queued: Array<() => void> = [];
  function track(name: string, params: Record<string, string>) {
    const send = () =>
      window.gtag?.('event', name, {
        source: 'business_card',
        ...params,
        transport_type: 'beacon',
      });
    if (window.gtag) send();
    else queued.push(send);
  }

  const root = document.querySelector<HTMLElement>('[data-card]');
  if (root) {
    document.addEventListener(root.dataset.consentEvent ?? '', () =>
      // Deferred so the GA loader's own listener has defined gtag first.
      setTimeout(() => queued.splice(0).forEach((send) => send())),
    );

    // Set by the inline script at the top of the section (card-platform.ts),
    // which the styles below use to put the visitor's own store first.
    const platform = (root.dataset.platform ?? 'desktop') as Platform;

    root.querySelectorAll<HTMLAnchorElement>('a[data-store]').forEach((link) => {
      link.href = withCampaign(link.href);
      link.addEventListener('click', () =>
        track('business_card_store_click', {
          platform,
          store: link.dataset.store ?? '',
          destination: link.href,
        }),
      );
    });

    track('business_card_visit', { platform });
    track(`business_card_${platform}`, { platform });
  }
</script>

<style>
  .card {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding-block: var(--space-12);
    text-align: center;
  }
  .card__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
  }
  .card__logo {
    color: var(--ink);
  }
  .card__logo :global(.wordmark) {
    height: 48px;
  }
  .card__view {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }
  .card__lead {
    max-width: 440px;
    color: var(--taupe-dark);
    font-size: 18px;
    line-height: 28px;
  }
  .card__view :global(.store-badges) {
    justify-content: center;
    margin-top: var(--space-2);
  }
  /* On a phone or tablet the visitor's own store leads: its badge first, the
     other store's below a short caption. Both badges keep their official
     artwork at the same size — neither store allows its badge to be dimmed,
     recoloured or shown smaller than the other — so the emphasis is order
     alone. Desktop, unknown devices and no-JS visitors get the two side by
     side with equal weight. */
  .card[data-platform='ios'] :global(.store-badges),
  .card[data-platform='android'] :global(.store-badges) {
    flex-direction: column;
    gap: var(--space-3);
  }
  .card[data-platform='ios'] :global(.store-badges::before),
  .card[data-platform='android'] :global(.store-badges::before) {
    order: 1;
    margin-top: var(--space-2);
    color: var(--taupe-dark);
    font-size: 14px;
    line-height: 20px;
  }
  .card[data-platform='ios'] :global(.store-badges::before) {
    content: 'Also available on Android';
  }
  .card[data-platform='android'] :global(.store-badges::before) {
    content: 'Also available on iPhone and iPad';
  }
  .card[data-platform='ios'] :global(a[data-store='android']),
  .card[data-platform='android'] :global(a[data-store='ios']) {
    order: 2;
  }
  .card__note {
    color: var(--taupe-dark);
    font-size: 15px;
    line-height: 24px;
  }
  .card__home {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.01em;
  }
</style>
