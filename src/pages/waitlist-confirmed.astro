---
/**
 * Post-confirmation landing page. Kit's signup form is configured (in the
 * Kit dashboard, not code) to redirect here after a subscriber clicks the
 * double opt-in link in their email — keeping the confirm moment on-brand
 * instead of on a Kit-hosted page. The /waitlist-confirmed path is what
 * Kit redirects to, so renaming this route means updating Kit too.
 *
 * Only reachable via that email link, so it's noindex'd and excluded from
 * the sitemap (see astro.config.mjs).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---

<BaseLayout
  title={`You're all set — ${SITE.name}`}
  description="You're signed up for Handsful launch updates."
  noindex={true}
>
  <section class="confirmed section">
    <div class="container--narrow">
      <p class="confirmed__eyebrow">Email confirmed</p>
      <h1>You're on the list! 🎉</h1>
      <p class="confirmed__lead">
        That's it — no more steps. We'll email you launch news, the Android release, and the
        occasional tip for parents of multiples. Haven't pre-ordered yet? The App Store badge is
        waiting at the top of the site. Until then, go rest those hands.
      </p>
      <a class="btn btn--primary" href="/">Back to the site</a>
    </div>
  </section>
</BaseLayout>

<style>
  .confirmed {
    text-align: center;
  }
  .confirmed__eyebrow {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--teal);
  }
  .confirmed h1 {
    margin-top: var(--space-3);
  }
  .confirmed__lead {
    max-width: 520px;
    margin-inline: auto;
    margin-top: var(--space-4);
    color: var(--taupe-dark);
    font-size: 18px;
    line-height: 28px;
  }
  .confirmed .btn {
    margin-top: var(--space-8);
  }
</style>
