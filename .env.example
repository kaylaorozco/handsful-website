# Copy to .env for local dev; set the same vars in Vercel → Project → Settings → Environment Variables.

# Where /api/subscribe forwards waitlist signups (POST, JSON body: { email, source, timestamp }).
# Point this at a Zapier/Make webhook, a Google Apps Script, or later a Mailchimp/ConvertKit/Supabase
# adapter endpoint. If unset, signups are logged server-side and the form still reports success.
WAITLIST_WEBHOOK_URL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). GA only loads after the visitor
# accepts the cookie banner. Leave empty to disable GA entirely (banner still shows
# so consent is already captured before analytics go live).
PUBLIC_GA_MEASUREMENT_ID=
