# Copy to .env for local dev; set the same vars in Vercel → Project → Settings → Environment Variables.

# Kit (ConvertKit) v4 API key — server-side only, never exposed to the client.
# Create one at app.kit.com → Account settings → Developer. /api/subscribe uses it
# to add waitlist signups to the form below; Kit then sends the double opt-in email.
KIT_API_KEY=

# Numeric ID of the Kit form the waitlist subscribes to (double opt-in enabled,
# confirmation redirect set to https://handsful.app/waitlist-confirmed in Kit).
KIT_FORM_ID=
